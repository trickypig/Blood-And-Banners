@page "/"

@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Components
@using BloodAndBanners.UI.Services
@inject GameApiClient Api

@if (_game is null)
{
    <QuickStart IsBusy="_isBusy" ErrorMessage="@_error" OnCreate="CreateGame" />
}
else
{
    <GameTable Projection="_game" />
}

@code {
    private GameProjection? _game;
    private bool _isBusy;
    private string? _error;

    private async Task CreateGame(GameMode mode)
    {
        _isBusy = true;
        _error = null;
        try
        {
            var session = await Api.CreateGuestAsync($"maui-{Guid.NewGuid():N}");
            _game = await Api.CreateGameAsync(session, mode, mode switch
            {
                GameMode.VanillaPvp => "Training Grounds",
                GameMode.Coop => "Portal Watch",
                GameMode.BattleRoyale => "Last Banner",
                _ => "Training Grounds"
            });
        }
        catch (Exception)
        {
            _error = "The war room could not be reached. Check your connection and try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
