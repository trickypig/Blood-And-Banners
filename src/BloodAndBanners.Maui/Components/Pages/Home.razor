@page "/"
@implements IDisposable

@using BloodAndBanners.UI.Components
@using BloodAndBanners.UI.Services

@* A new link restarts the game view so it reads the codes afresh, as a reload does on the web. *@
<GameExperience @key="_linkCount"
                ClientKind="maui"
                InitialJoinCode="@_joinCode"
                InitialWatchCode="@_watchCode"
                InitialSignInToken="@_signInToken"
                InviteBaseUri="https://blood.trickypig.com/play/"
                ImageBaseUrl="https://blood.trickypig.com/"
                OnStoppedWatching="() => _watchCode = null"
                OnSignInLinkHandled="() => _signInToken = null" />

@code {
    private int _linkCount;
    private string? _joinCode;
    private string? _watchCode;
    private string? _signInToken;

    protected override void OnInitialized()
    {
        if (IncomingLinks.Latest is { } uri)
        {
            ReadLink(uri);
        }

        IncomingLinks.Received += OnLinkReceived;
    }

    private void OnLinkReceived(string uri) => InvokeAsync(() =>
    {
        if (InviteLinks.IsEditorUri(uri)) return;
        ReadLink(uri);
        _linkCount++;
        StateHasChanged();
    });

    private void ReadLink(string uri)
    {
        _joinCode = InviteLinks.GameIdFromUri(uri);
        _watchCode = InviteLinks.WatchGameIdFromUri(uri);
        _signInToken = InviteLinks.SignInTokenFromUri(uri);
    }

    public void Dispose() => IncomingLinks.Received -= OnLinkReceived;
}
