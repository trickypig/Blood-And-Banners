@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services

<section class="void-setup" aria-labelledby="void-setup-title">
    <h2 id="void-setup-title">@(IsVoidLord ? "Summon your horde" : "The Void stirs")</h2>
    @if (!IsVoidLord)
    {
        <p role="status">The Void Lord is placing monsters · @MonstersPlaced @(MonstersPlaced == 1 ? "monster" : "monsters") placed</p>
    }
    else
    {
        @if (InWarRoom)
        {
            <div class="void-setup__war-room">
                <button type="button" class="void-setup__back" data-action="back-to-war-room" @onclick="() => OnBackToWarRoom.InvokeAsync()">Back to war room</button>
                <button type="button" class="void-setup__ready-toggle" data-action="toggle-ready" disabled="@IsBusy" @onclick="() => OnReadyChanged.InvokeAsync(!ViewerReady)">
                    @(ViewerReady ? "Stand down" : "Ready your banner")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(StartNote))
            {
                <p class="void-setup__status" data-testid="start-note" role="status">@StartNote</p>
            }
            <p class="void-setup__hint">You confirm the horde once the host begins.</p>
        }
        @if (Setup.Confirmed)
        {
            <p class="void-setup__ready" data-testid="setup-ready" role="status">Your horde stands ready.</p>
        }
        else
        {
            <p class="void-setup__budget" data-testid="setup-budget" role="status">Budget @Setup.Spent / @Setup.Budget@(Setup.MaxBudget is { } most ? $" · up to {most} with 4 heroes" : null)</p>
            <meter min="0" max="@Setup.Budget" value="@Setup.Spent" aria-label="Budget spent"></meter>
            @if (Setup.Spent > Setup.Budget && Setup.MaxBudget is not null)
            {
                <p class="void-setup__ahead" data-testid="setup-over-budget">Over the current budget by @(Setup.Spent - Setup.Budget). Fine for now; you'll need to be within budget to confirm.</p>
            }
            else if (Setup.Spent > Setup.Budget)
            {
                <p class="void-setup__over" data-testid="setup-over-budget" role="alert">Over budget by @(Setup.Spent - Setup.Budget) — remove monsters before you confirm.</p>
            }
            <p class="void-setup__hint">Choose a monster, then a glowing spawn hex. Click a placed monster to remove it.</p>
            @if (Setup.Roster.FirstOrDefault(monster => monster.Name == SelectedMonster) is { } selected)
            {
                <div class="void-setup__abilities" aria-label="Selected monster abilities">
                    <strong>@selected.Name</strong>
                    <AbilityList Abilities="selected.Abilities" />
                </div>
            }
            @foreach (var biome in Setup.Roster.GroupBy(monster => monster.Biome))
            {
                <h3>@biome.Key</h3>
                <ul class="void-setup__roster">
                    @foreach (var monster in biome.OrderBy(monster => TierOrder(monster.Tier)).ThenBy(monster => monster.Name))
                    {
                        var affordable = monster.Cost <= (Setup.MaxBudget ?? Setup.Budget) - Setup.Spent;
                        <li>
                            <button type="button"
                                    data-monster="@monster.Name"
                                    aria-pressed="@(monster.Name == SelectedMonster ? "true" : "false")"
                                    disabled="@(!affordable || IsBusy)"
                                    @onclick="() => OnSelectMonster.InvokeAsync(monster.Name)">
                                @if (CatalogImages.Resolve(ImageBaseUrl, monster.Image) is { } art)
                                {
                                    <img src="@art" alt="" loading="lazy" />
                                }
                                <strong>@monster.Name</strong>
                                <span class="tier tier--@monster.Tier">@monster.Tier · @monster.Cost pt</span>
                                <small>M@(monster.Move) R@(monster.Range) P@(monster.Power) D@(monster.Defense) HP@(monster.Hp)</small>
                            </button>
                        </li>
                    }
                </ul>
            }
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public SetupProjection Setup { get; set; } = default!;
    [Parameter] public bool IsVoidLord { get; set; }
    [Parameter] public string? SelectedMonster { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? ImageBaseUrl { get; set; }
    [Parameter] public int MonstersPlaced { get; set; }
    [Parameter] public EventCallback<string> OnSelectMonster { get; set; }
    /// <summary>The war room is still open: the board offers the way back and the Void Lord's own readiness.</summary>
    [Parameter] public bool InWarRoom { get; set; }
    [Parameter] public bool ViewerReady { get; set; }
    [Parameter] public string? StartNote { get; set; }
    [Parameter] public EventCallback<bool> OnReadyChanged { get; set; }
    [Parameter] public EventCallback OnBackToWarRoom { get; set; }

    private static int TierOrder(string tier) => tier switch { "common" => 0, "elite" => 1, "boss" => 2, _ => 3 };
}
