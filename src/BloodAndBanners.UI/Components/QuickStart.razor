@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services

<section class="quick-start" aria-labelledby="quick-start-title">
    <MainMenu ClientKind="@ClientKind" />
    <div class="intro-copy">
        <p class="game-name">Blood &amp; Banners</p>
        <h1 id="quick-start-title">Take the field.</h1>
        <p>
            Open a war room in seconds. Invite players from web or mobile,
            then let the server keep every move, roll, and victory honest.
        </p>
    </div>

    @if (StatusMessage is not null)
    {
        <p class="status" role="status">@StatusMessage</p>
    }

    @if (!_choosingBattlefield)
    {
        <div class="mode-list" aria-label="Choose a game mode">
            <button type="button" data-mode="vanillaPvp" disabled="@IsBusy" @ref="_vanillaButton" @onclick="() => ChooseMode(GameMode.VanillaPvp)">
                <strong>Vanilla duel</strong>
                <span>Two commanders. One hero and army each. No second chances.</span>
            </button>
            <button type="button" data-mode="coop" disabled="@IsBusy" @ref="_coopButton" @onclick="() => ChooseMode(GameMode.Coop)">
                <strong>Void incursion</strong>
                <span>One Void Lord against one to four allied commanders.</span>
            </button>
            <button type="button" data-mode="battleRoyale" disabled="@IsBusy" @onclick="() => ChooseMode(GameMode.BattleRoyale)">
                <strong>Battle royale</strong>
                <span>A human dungeon master drives the battlefield against two to four rivals.</span>
            </button>

            <form class="join-room" @onsubmit="Join" @onsubmit:preventDefault>
                <label for="join-code">Have an invite?</label>
                <div>
                    <input id="join-code"
                           data-join-code
                           autocomplete="off"
                           placeholder="Paste a game code"
                           disabled="@IsBusy"
                           @bind="_joinCode"
                           @bind:event="oninput" />
                    <button type="submit"
                            data-action="join-game"
                            disabled="@(IsBusy || string.IsNullOrWhiteSpace(_joinCode))">
                        Join war room
                    </button>
                    <button type="button"
                            class="watch"
                            data-action="watch-game"
                            disabled="@(IsBusy || string.IsNullOrWhiteSpace(_joinCode))"
                            @onclick="Watch">
                        Watch
                    </button>
                </div>
            </form>
        </div>
        <AccountHome IsBusy="IsBusy" OnResume="OnResume" OnJoin="OnJoin" OnWatch="OnWatch" />
    }
    else
    {
        <section class="battlefield-picker" data-testid="battlefield-picker" aria-labelledby="battlefield-title">
            <header>
                <h2 id="battlefield-title" tabindex="-1" @ref="_pickerHeading">Choose the battlefield.</h2>
                <p>Terrain changes the fight. Pick the ground before the banners rise.</p>
            </header>
            <div class="battlefield-list" role="radiogroup" aria-label="@(_pickerMode == GameMode.Coop ? "Void incursion battlefield" : "Vanilla battlefield")">
                @foreach (var battlefield in Battlefields)
                {
                    var selected = battlefield.Name == _selectedScenario;
                    <button type="button"
                            class="battlefield-card @(selected ? "selected" : null)"
                            role="radio"
                            aria-checked="@(selected ? "true" : "false")"
                            data-scenario="@battlefield.Name"
                            disabled="@IsBusy"
                            @onclick="() => _selectedScenario = battlefield.Name">
                        <span class="battlefield-name">@battlefield.Name</span>
                        <span class="battlefield-size">@battlefield.Size</span>
                        <span class="battlefield-role">@battlefield.Role</span>
                        <span class="battlefield-tags">
                            @foreach (var tag in battlefield.Tags)
                            {
                                <span>@tag</span>
                            }
                        </span>
                        <span class="battlefield-map">
                            @if (_boards.TryGetValue(battlefield.Name, out var board))
                            {
                                <MapPreview Board="board" Name="@battlefield.Name" ImageBaseUrl="@ImageBaseUrl" />
                            }
                        </span>
                    </button>
                }
            </div>
            <div class="picker-actions">
                <button type="button" class="back" data-action="back-modes" disabled="@IsBusy" @onclick="BackToModes">Back</button>
                <button type="button" class="create" data-action="create-game" disabled="@IsBusy" @onclick="CreateGame">Open war room</button>
            </div>
        </section>
    }

    @if (IsBusy)
    {
        <p class="connection-note" role="status">Raising your banner…</p>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="connection-error" role="alert">
            <p>@ErrorMessage</p>
            @if (!string.IsNullOrWhiteSpace(WatchOfferGameId))
            {
                <button type="button" class="watch-instead" data-action="watch-instead" @onclick="() => OnWatch.InvokeAsync(WatchOfferGameId)">
                    Watch this match instead
                </button>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string? ImageBaseUrl { get; set; }
    [Parameter]
    public string ClientKind { get; set; } = "client";

    [Parameter]
    public string? StatusMessage { get; set; }

    /// <summary>Raised with a game id when a signed-in player resumes one of their games.</summary>
    [Parameter]
    public EventCallback<string> OnResume { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<GameSetupSelection> OnCreate { get; set; }

    [Parameter]
    public EventCallback<string> OnJoin { get; set; }

    [Parameter]
    public EventCallback<string> OnWatch { get; set; }

    /// <summary>A game the player tried to join but cannot; when set, the error offers to watch it.</summary>
    [Parameter]
    public string? WatchOfferGameId { get; set; }

    [Parameter]
    public string? InitialJoinCode { get; set; }

    /// <summary>Fetches a battlefield's board for its card preview; cards without one simply show no map.</summary>
    [Parameter]
    public Func<string, Task<BoardProjection>>? LoadBoard { get; set; }

    private string _joinCode = string.Empty;
    private bool _choosingBattlefield;
    private GameMode _pickerMode = GameMode.VanillaPvp;
    private string _selectedScenario = "Four Corners";
    private bool _focusPicker;
    private bool _focusMode;
    private readonly Dictionary<string, BoardProjection> _boards = [];
    private ElementReference _pickerHeading;
    private ElementReference _vanillaButton;
    private ElementReference _coopButton;

    private static readonly Battlefield[] VanillaBattlefields =
    [
        new("Four Corners", "13 × 11", "Maximum terrain", ["Water", "Ice", "Lava", "Poison"]),
        new("Proving Field", "11 × 9", "Classic duel", ["Open lanes", "Balanced"]),
        new("Home Map", "32 × 30", "Grand battlefield", ["Large", "Mixed ground"]),
    ];

    /// <summary>Void Reaches, then the five hexagonal drafts (scripts/build-incursion-maps.py) on trial.</summary>
    private static readonly Battlefield[] CoopBattlefields =
    [
        new("Void Reaches", "25 × 25", "The first incursion", ["Five biomes", "Crags"]),
        new("Twin Roads", "Hex 15", "Choose your flank", ["Forest or dunes", "Ice or fire", "Island crossing"]),
        new("Serpent's Coil", "Hex 15", "The long road", ["Switchback", "Lake shortcut", "Goat path"]),
        new("The Gorge", "Hex 15", "High ground", ["Cliffs", "High bridges", "Lake bowl"]),
        new("Lakeheart", "Hex 15", "Hold the Heart", ["Central hub", "Four causeways", "Quadrants"]),
        new("Blighted March", "Hex 15", "Escalating danger", ["Hazard bands", "Three crossings", "Lava lanes"]),
    ];

    private Battlefield[] Battlefields => _pickerMode == GameMode.Coop ? CoopBattlefields : VanillaBattlefields;

    protected override void OnParametersSet()
    {
        if (_joinCode.Length == 0 && !string.IsNullOrWhiteSpace(InitialJoinCode))
        {
            _joinCode = InitialJoinCode.Trim();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPicker)
        {
            _focusPicker = false;
            await _pickerHeading.FocusAsync();
        }
        else if (_focusMode)
        {
            _focusMode = false;
            await (_pickerMode == GameMode.Coop ? _coopButton : _vanillaButton).FocusAsync();
        }
    }

    private Task ChooseMode(GameMode mode)
    {
        if (mode is GameMode.VanillaPvp or GameMode.Coop)
        {
            _pickerMode = mode;
            _selectedScenario = Battlefields[0].Name;
            _choosingBattlefield = true;
            _focusPicker = true;
            return LoadPreviews();
        }
        return OnCreate.InvokeAsync(new GameSetupSelection(mode, "Last Banner"));
    }

    private async Task LoadPreviews()
    {
        if (LoadBoard is null)
        {
            return;
        }

        var loads = Battlefields
            .Where(battlefield => !_boards.ContainsKey(battlefield.Name))
            .Select(battlefield => (battlefield.Name, Board: LoadBoard(battlefield.Name)))
            .ToList();
        foreach (var (name, load) in loads)
        {
            try
            {
                _boards[name] = await load;
                StateHasChanged();
            }
            catch (Exception)
            {
                // A preview is decoration: a battlefield whose board cannot be fetched is still pickable by name.
            }
        }
    }

    private Task CreateGame() => OnCreate.InvokeAsync(new GameSetupSelection(_pickerMode, _selectedScenario));

    private void BackToModes()
    {
        _choosingBattlefield = false;
        _focusMode = true;
    }

    private Task Join() => string.IsNullOrWhiteSpace(_joinCode)
        ? Task.CompletedTask
        : OnJoin.InvokeAsync(_joinCode.Trim());

    private Task Watch() => string.IsNullOrWhiteSpace(_joinCode)
        ? Task.CompletedTask
        : OnWatch.InvokeAsync(_joinCode.Trim());

    private sealed record Battlefield(string Name, string Size, string Role, IReadOnlyList<string> Tags);
}
