@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services
@using Microsoft.AspNetCore.Components.Forms

<main class="map-editor">
    <MainMenu IsEditor="true" ClientKind="@ClientKind" />
    <header><h1>Blood &amp; Banners - Map Editor</h1></header>
    <div class="editor-workspace">
        <div class="editor-toolbars">
            <div class="editor-toolbar file-toolbar" role="toolbar" aria-label="Map files and zoom">
                <div class="toolbar-group" role="group" aria-label="Map files">
                    @foreach (var (action, label) in FileActions)
                    {
                        if (action == "import")
                        {
                            <label class="icon-button file-button" title="@label">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@IconPath(action)" /></svg>
                                <InputFile OnChange="Import" accept=".json,application/json" disabled="@_busy" aria-label="Import JSON" />
                            </label>
                        }
                        else
                        {
                            <button type="button" class="icon-button" data-action="@action" title="@FileLabel(action, label)" aria-label="@FileLabel(action, label)"
                                    disabled="@(_busy || (RequiresAccount(action) && Account.Current is null))" @onclick="() => FileAction(action)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@IconPath(action)" /></svg>
                            </button>
                        }
                    }
                </div>
                <div class="toolbar-group" role="group" aria-label="Zoom">
                    @foreach (var action in new[] { "zoom-out", "zoom-reset", "zoom-in" })
                    {
                        var label = action == "zoom-reset" ? "Reset zoom" : action == "zoom-in" ? "Zoom in" : "Zoom out";
                        <button type="button" class="icon-button" title="@label" aria-label="@label"
                                disabled="@(action == "zoom-out" && _zoom <= .5 || action == "zoom-in" && _zoom >= 2)" @onclick="() => ChangeZoom(action)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@IconPath(action)" /></svg>
                        </button>
                    }
                </div>
            </div>
            <div class="editor-toolbar action-toolbar" role="toolbar" aria-label="Map editing actions">
                <div class="toolbar-group biomes" role="group" aria-label="Terrain">
                    @foreach (var biome in TerrainArt.BiomeNames)
                    {
                        var terrain = _terrains[biome];
                        var label = $"Paint {Display(biome)}: {Display(terrain)}. Click again to cycle terrain.";
                        <button type="button" class="icon-button" data-biome="@biome" data-terrain="@terrain" title="@label" aria-label="@label" disabled="@_busy"
                                aria-pressed="@(_tool == "paint" && _biome == biome ? "true" : "false")" @onclick="() => SelectBiome(biome)">
                            <span class="terrain-preview" aria-hidden="true" style="background-color: @TerrainArt.Color(biome)">
                                @if (CatalogImages.Resolve(ImageBaseUrl, TerrainArt.ImagePath(biome, terrain)) is { } preview)
                                {
                                    <img src="@preview" alt="" draggable="false" />
                                }
                            </span>
                        </button>
                    }
                </div>
                <div class="toolbar-group" role="group" aria-label="Elevation">
                    @foreach (var action in new[] { "raise", "lower", "reset" })
                    {
                        var label = $"{Display(action)} elevation";
                        <button type="button" class="icon-button" data-height="@action" title="@label" aria-label="@label" disabled="@_busy"
                                aria-pressed="@(_tool == "height" && _heightAction == action ? "true" : "false")" @onclick="() => SelectHeight(action)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@IconPath(action)" /></svg>
                        </button>
                    }
                </div>
                <div class="toolbar-group" role="group" aria-label="Player starts">
                    @foreach (var player in new[] { 1, 2, 3, 4, 0 })
                    {
                        var label = player == 0 ? "Remove player start" : $"Place player {player} start";
                        <button type="button" class="icon-button player-button" data-player="@player" title="@label" aria-label="@label" disabled="@_busy"
                                aria-pressed="@(_tool == "player" && _player == player ? "true" : "false")" @onclick="() => SelectPlayer(player)">
                            @if (player == 0)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3v18M5 4h14l-3 4 3 4H5m7 4 7 7m0-7-7 7" /></svg>
                            }
                            else { <span aria-hidden="true" style="--player-color: @StartColor(player)">@($"P{player}")</span> }
                        </button>
                    }
                </div>
                <div class="toolbar-group" role="group" aria-label="Obstacles">
                    @{
                        var addLabel = $"Add {ObstacleArt.Display(_obstacle)}. Click again to switch to {ObstacleArt.Display(NextObstacle)}.";
                    }
                    <button type="button" class="icon-button obstacle-button" data-obstacle="@_obstacle" title="@addLabel" aria-label="@addLabel" disabled="@_busy"
                            aria-pressed="@(_tool == "obstacle" ? "true" : "false")" @onclick="SelectObstacle">
                        @if (CatalogImages.Resolve(ImageBaseUrl, ObstacleArt.ImagePath(_obstacle)) is { } obstaclePreview)
                        {
                            <img src="@obstaclePreview" alt="" draggable="false" />
                        }
                        else { <span aria-hidden="true">@ObstacleArt.Display(_obstacle)[0]</span> }
                    </button>
                    <button type="button" class="icon-button" data-action="clear-obstacle" title="Clear obstacles" aria-label="Clear obstacles" disabled="@_busy"
                            aria-pressed="@(_tool == "clear-obstacle" ? "true" : "false")" @onclick="SelectClearObstacle">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@IconPath("clear-obstacle")" /></svg>
                    </button>
                </div>
            </div>
        </div>
        <div class="editor-statusbar">
            <div class="map-name">
                <button type="button" class="map-name-button" data-action="rename" title="Rename map" aria-label="Rename map" disabled="@_busy" @onclick="OpenRename"><strong>@_document.Definition.Name</strong></button>
            </div>
            <div role="status"><strong>Status:</strong> @(_document.IsDirty ? "Unsaved changes" : "Ready")@if (!string.IsNullOrEmpty(_status)) { <span> &middot; @_status</span> }</div>

            <div class="hex-info"><strong>Selected hex:</strong>
                @if (_document.SelectedHex is { } selected)
                {
                    <span>@selected.Q, @selected.R &middot; @Display(selected.Biome) / @Display(selected.Terrain) &middot; Height: @selected.Elevation &middot; Start: @(selected.PlayerStart?.ToString() ?? "none")@if (ObstacleArt.IsObstacle(selected.Object)) { <text> &middot; Obstacle: @ObstacleArt.Display(selected.Object!)</text> } else if (selected.SightBlocker) { <text> &middot; Blocked</text> }</span>
                }
                else { <span>None</span> }
            </div>
        </div>
        <section class="map-panel" aria-label="Map canvas">
            @if (_error is not null)
            {
                <div role="alert"><p>@_error</p>
                    @if (_conflict && _document.SavedSummary is { } saved)
                    {
                        <button type="button" data-action="reload" disabled="@_busy" @onclick="() => RequestLoad(saved.ScenarioId)">Reload saved map</button>
                    }
                </div>
            }
            <div class="map-scroll" tabindex="0" aria-label="Scrollable map">
                <svg class="editor-board" viewBox="0 0 @Num(Layout.Width) @Num(Layout.Height)"
                     style="width: @Num(_zoom * 100)%; min-width: @Num(420 * _zoom)px;" role="group" aria-label="Editable battlefield">
                    <TerrainPatterns Hexes="_hexes" ImageBaseUrl="@ImageBaseUrl" IdPrefix="editor-terrain-" />
                    @foreach (var tile in Layout.Tiles)
                    {
                        var hex = tile.Hex;
                        <g @key="(hex.Q, hex.R)" role="button" tabindex="0" data-hex="@($"{hex.Q},{hex.R}")"
                           class="editor-hex @(_document.Selection == (hex.Q, hex.R) ? "selected" : "")"
                           aria-label="@($"Hex {hex.Q}, {hex.R}, {hex.Biome} {hex.Terrain}, height {hex.Elevation}{(ObstacleArt.IsObstacle(hex.Object) ? $", {hex.Object}" : "")}")"
                           aria-disabled="@(_busy ? "true" : "false")" @onclick="() => Edit(hex.Q, hex.R)"
                           @onkeydown="e => HexKey(e, hex.Q, hex.R)">
                            <HexTerrain Tile="tile" PatternId="@TerrainArt.PatternId(hex, "editor-terrain-")" />
                            <polygon class="hex-outline" points="@tile.TopPoints" />
                            @if (hex.Elevation != 0)
                            {
                                <!text class="height-label" x="@Num(tile.X - BoardLayout.Size * .42)" y="@Num(tile.Y - BoardLayout.Size * .5)" fill="@TerrainArt.LabelColor(hex.Biome)">@(hex.Elevation > 0 ? $"+{hex.Elevation}" : hex.Elevation.ToString())</!text>
                            }
                            @if (hex.PlayerStart is { } start)
                            {
                                <circle class="start-marker" cx="@Num(tile.X)" cy="@Num(tile.Y + 10)" r="13" fill="@StartColor(start)" />
                                <!text class="start-label" x="@Num(tile.X)" y="@Num(tile.Y + 10)">@($"P{start}")</!text>
                            }
                            <HexObstacle Tile="tile" ImageBaseUrl="@ImageBaseUrl" />
                        </g>
                    }
                </svg>
            </div>
        </section>
    </div>
    @if (_dialog is not null && _pending is null)
    {
        <div class="confirm-backdrop" @onkeydown="DialogKey">
            <section class="confirm" role="dialog" aria-modal="true" aria-labelledby="editor-dialog-title" tabindex="-1" @ref="_dialogElement">
                <h2 id="editor-dialog-title">@(_dialog == "new" ? "New map" : _dialog == "load" ? "Load map" : "Rename map")</h2>
                @if (_dialog == "load")
                {
                    <SavedMapsPanel Maps="_maps" IsBusy="_busy" OnLoad="RequestLoad" OnRefresh="RefreshMaps" />
                    @if (_error is not null) { <p role="alert">@_error</p> }
                    <button type="button" data-action="close-dialog" @onclick="CloseDialog">Close</button>
                }
                else
                {
                    <form @onsubmit="SubmitDialog" @onsubmit:preventDefault>
                        <label for="@(_dialog == "new" ? "new-map-name" : "map-name")">Map name</label>
                        <input id="@(_dialog == "new" ? "new-map-name" : "map-name")" maxlength="120" required @bind="_draftName" @bind:event="oninput" />
                        @if (_dialog == "new")
                        {
                            <div class="dimensions">
                                <label for="new-map-columns">Columns<input id="new-map-columns" type="number" min="5" max="30" required @bind="_columns" /></label>
                                <label for="new-map-rows">Rows<input id="new-map-rows" type="number" min="5" max="30" required @bind="_rows" /></label>
                            </div>
                        }
                        @if (_dialogError is not null) { <p role="alert">@_dialogError</p> }
                        <div class="buttons">
                            <button type="button" @onclick="CloseDialog">Cancel</button>
                            <button type="submit">@(_dialog == "new" ? "Create map" : "Rename")</button>
                        </div>
                    </form>
                }
            </section>
        </div>
    }
    @if (_pending is not null)
    {
        <div class="confirm-backdrop">
            <section class="confirm" role="alertdialog" aria-modal="true" aria-labelledby="discard-title">
                <h2 id="discard-title">Discard unsaved changes?</h2>
                <p>Export your map first if you want to keep a local copy.</p>
                <button type="button" data-action="keep-editing" @onclick="() => _pending = null">Keep editing</button>
                <button type="button" data-action="discard" @onclick="Discard">Discard changes</button>
            </section>
        </div>
    }
</main>
