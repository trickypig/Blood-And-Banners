@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services

<section class="combat-log" aria-label="@Title">
    <h2>@Title</h2>
    @if (Lines.Count == 0)
    {
        <p>@EmptyText</p>
    }
    else
    {
        <ol aria-live="polite">
            @foreach (var line in Lines)
            {
                <li data-event="@line.Kind">@line.Text</li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public GameProjection Projection { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<GameEvent> Events { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "Battle log";

    [Parameter]
    public string EmptyText { get; set; } = "No blows struck yet.";

    private IReadOnlyList<(string Kind, string Text)> Lines => CombatLogFormatter.Recent(Events, Projection, 40);
}
