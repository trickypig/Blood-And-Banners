@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services

@if (_layout is { } layout)
{
    <svg class="map-preview"
         viewBox="0 0 @Num(layout.Width) @Num(layout.Height)"
         role="img"
         aria-label="@($"{Name} map preview with {_starts.Count} starting points")">
        @foreach (var dot in layout.Dots)
        {
            <circle class="map-dot"
                    data-hex="@($"{dot.Hex.Q},{dot.Hex.R}")"
                    cx="@Num(dot.X)"
                    cy="@Num(dot.Y)"
                    r="@Num(DotRadius)"
                    fill="@TerrainArt.Color(dot.Hex.Biome)" />
        }
        @foreach (var start in _starts)
        {
            <g class="map-start @(start.Hex.PlayerStart == HighlightStart ? "mine" : null)" data-start="@start.Hex.PlayerStart">
                <circle cx="@Num(start.X)" cy="@Num(start.Y)" r="@Num(_markerRadius)" stroke-width="@Num(_markerRadius / 4)" />
                <StartingPortal Player="@(start.Hex.PlayerStart!.Value)" X="start.X" Y="start.Y" Size="@(_markerRadius * 2.4)" ImageBaseUrl="@ImageBaseUrl" />
                <text x="@Num(start.X)" y="@Num(start.Y)" font-size="@Num(_markerRadius * 1.3)" text-anchor="middle" dominant-baseline="central">@start.Hex.PlayerStart</text>
            </g>
        }
        @foreach (var gate in layout.Dots.Where(dot => dot.Hex.VoidPortal))
        {
            <VoidPortal X="gate.X" Y="gate.Y" Size="@(_markerRadius * 2.4)" Phase="VoidPortalArt.Phase.Icon" ImageBaseUrl="@ImageBaseUrl" />
        }
    </svg>
}

@code {
    /// <summary>Dots sit a little inside each hex so the terrain reads as a stipple rather than a solid sheet.</summary>
    private const double DotRadius = BoardLayout.Size * .8;

    [Parameter, EditorRequired]
    public BoardProjection Board { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter] public string? ImageBaseUrl { get; set; }

    /// <summary>The viewer's start position, drawn in the accent colour.</summary>
    [Parameter]
    public int? HighlightStart { get; set; }

    private PlanLayout? _layout;
    private IReadOnlyList<PlanDot> _starts = [];
    private double _markerRadius;

    // What the last render drew. A picker re-renders every card each time another board arrives, and
    // Blazor cannot tell an unchanged board apart, so a preview skips both the layout and the render itself.
    private BoardProjection? _laidOut;
    private (string Name, string? ImageBaseUrl, int? HighlightStart) _drawn;
    private bool _changed = true;

    protected override void OnParametersSet()
    {
        var drawn = (Name, ImageBaseUrl, HighlightStart);
        if (ReferenceEquals(Board, _laidOut) && drawn == _drawn)
        {
            return;
        }
        _changed = true;
        _drawn = drawn;
        if (ReferenceEquals(Board, _laidOut))
        {
            return;
        }
        _laidOut = Board;

        if (Board.Hexes.Count == 0)
        {
            _layout = null;
            _starts = [];
            return;
        }

        // A preview is a plan view: elevation is flattened so every dot sits on the same grid.
        _layout = BoardLayout.Plan(Board.Hexes);
        _starts = _layout.Dots.Where(dot => dot.Hex.PlayerStart is not null).OrderBy(dot => dot.Hex.PlayerStart).ToList();
        // Markers grow with the board so they stay legible however far a large map is scaled down.
        _markerRadius = Math.Max(BoardLayout.Size, Math.Max(_layout.Width, _layout.Height) * .07);
    }

    protected override bool ShouldRender() => _changed;

    protected override void OnAfterRender(bool firstRender) => _changed = false;

    private static string Num(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
