        var path = movement.Path.ToArray();
        if (_confirmingMovementAbility is { } ability)
        {
            var toHex = movement.Destination;
            CancelTargeting();
            await Send("moveAbility", new { unitId, ability, toHex });
            return;
        }
        await Send("moveUnit", new { unitId, path });
    }

