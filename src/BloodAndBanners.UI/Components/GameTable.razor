    /// <summary>Lookups over the current projection, rebuilt only when a new projection arrives.</summary>
    private BoardIndex Index
    {
        get
        {
            if (_index is null || !ReferenceEquals(_indexedProjection, Projection))
            {
                _index = BoardIndex.For(this);
                _indexedProjection = Projection;
            }
            return _index;
        }
