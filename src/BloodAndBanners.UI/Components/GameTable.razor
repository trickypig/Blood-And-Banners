    private async Task BeginBoardPointer(PointerEventArgs args, bool canPan)
    {
        await MeasureBoard();
        _viewport.BeginPointer(args.PointerId, LocalPoint(args.ClientX, args.ClientY), args.PointerType == "touch", canPan);
        if (canPan && _viewportModule is not null)
        {
            _capturedPointers.Add(args.PointerId);
            await _viewportModule.InvokeVoidAsync("capturePointer", _boardElement, args.PointerId);
        }
    }

    private async Task MoveBoardPointer(PointerEventArgs args)
    {
        var center = _viewport.Center;
        _viewport.MovePointer(args.PointerId, LocalPoint(args.ClientX, args.ClientY));
        // Zooming, pinch included, keeps following on; only dragging the board takes the camera.
        if (!_viewport.IsPinching && center != _viewport.Center)
        {
            await PauseFollowing();
        }
    }

    private async Task PauseFollowing()
    {
        _followEvents = false;
        await OnFollowEvents.InvokeAsync();
    }

    private Task ToggleFollowing() => _followEvents ? PauseFollowing() : ResumeFollowing();

    private async Task ResumeFollowing()
    {
        _followEvents = true;
        FrameEvents();
        await OnFollowEvents.InvokeAsync();
    }

    /// <summary>
    /// An army-list click inspects the unit and pans the board to it when it is out of view.
    /// </summary>
    private async Task FocusUnit(UnitProjection unit)
    {
        if (unit.Hex is not { } hex || Index.TileByKey.GetValueOrDefault(hex) is not { } tile)
        {
            return;
        }
        _spotlitUnitId = unit.UnitId;
        _railOpen = false;
        ShowArmyTabOf(unit.UnitId);
        if (!IsBusy && !InSetup && Projection.PendingChoice is null && _targeting is null
            && unit.UnitId != _selectedUnitId && Inspectable(unit.UnitId))
        {
            ClearMovementState();
            _selectedUnitId = unit.UnitId;
        }
        await MeasureBoard();
        if (_viewport.Frame([new ViewportPoint(tile.X, tile.Y)], ActingUnitPoints(unit.UnitId), UnitPoints(), BoardLayout.Size))
        {
            await PauseFollowing();
        }
    }

    private async Task EndBoardPointer(PointerEventArgs args)
    {
        _viewport.EndPointer(args.PointerId);
        if (_capturedPointers.Remove(args.PointerId) && _viewportModule is not null)
        {
            await _viewportModule.InvokeVoidAsync("releasePointer", _boardElement, args.PointerId);
        }
    }

    private ViewportPoint LocalPoint(double clientX, double clientY) =>
        new(clientX - _boardBounds.Left, clientY - _boardBounds.Top);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        _viewportModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BloodAndBanners.UI/js/boardViewport.js");
        if (_viewportModule is null)
        {
            return;
        }
        await MeasureBoard();
        if (_boardBounds.Width > 0 && _boardBounds.Height > 0)
        {
            _viewport.Fit();
            StateHasChanged();
        }
    }

    private async Task MeasureBoard()
    {
        if (_viewportModule is null)
        {
            return;
        }
        _boardBounds = await _viewportModule.InvokeAsync<ElementBounds>("bounds", _boardElement) ?? new ElementBounds();
        if (_boardBounds.Width > 0 && _boardBounds.Height > 0)
        {
            _viewport.Resize(_boardBounds.Width, _boardBounds.Height);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_viewportModule is not null)
        {
            await _viewportModule.DisposeAsync();
        }
    }

    private sealed class ElementBounds
    {
        public double Left { get; init; }
        public double Top { get; init; }
        public double Width { get; init; }
        public double Height { get; init; }
    }

    private static string Num(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // One pattern per terrain image in use; variant 0 (the primary) keeps the plain id.
    private static string TerrainPatternId(HexProjection hex) =>
        "bb-terrain-" + SafeId($"{hex.Biome}-{hex.Terrain}") + (TerrainArt.Variant(hex.Q, hex.R) is var variant and > 0 ? $"-v{variant}" : "");

    private static readonly double HexHalfHeight = Math.Sqrt(3) / 2 * BoardLayout.Size;

    // Map tokens prefer the background-free avatar; cards elsewhere keep the full image.
    private string? TokenImage(UnitProjection unit) =>
        CatalogImages.Resolve(ImageBaseUrl, string.IsNullOrWhiteSpace(unit.AvatarImage) ? unit.Image : unit.AvatarImage);

    private static string SafeId(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value.ToLowerInvariant(), "[^a-z0-9-]", "-");

    private static int RemainingHp(UnitProjection unit) => Math.Clamp(unit.Hp - unit.Wounds, 0, Math.Max(0, unit.Hp));

    private static int HealthPercent(UnitProjection unit) =>
        unit.Hp <= 0 ? 0 : RemainingHp(unit) * 100 / unit.Hp;

    private static string HexKey(HexProjection hex) => $"{hex.Q},{hex.R}";

    private static string TerrainClass(HexProjection hex) =>
        $"terrain-{hex.Biome.ToLowerInvariant()}-{hex.Terrain.ToLowerInvariant().Replace(' ', '-')}";

    private string HexLabel(HexProjection hex, UnitProjection? unit) =>
        $"{Title(hex.Biome)} {hex.Terrain}, elevation {hex.Elevation}" +
        (ProjectedHazardAt(HexKey(hex)) is not { } hazard ? string.Empty : $", {HazardLabel(hazard)}") +
        (hex.OccupantId is null ? string.Empty : $", occupied by {unit?.Name ?? hex.OccupantId}") +
        (unit is null || unit.Effects.Count == 0 ? string.Empty : ", " + string.Join(", ", unit.Effects.Select(effect => $"{effect.Name} {(effect.Amount > 0 ? "+" : "")}{effect.Amount} {effect.Stat}"))) +
        (unit is null || unit.Conditions.Count == 0 ? string.Empty : ", " + string.Join(", ", unit.Conditions.Select(ConditionLabel))) +
        ActivationState(unit) switch
        {
            "activating" => ", activating",
            "spent" => ", already activated this turn",
            _ => string.Empty,
        };

    private static string HazardLabel(MovementHazardProjection hazard)
    {
        var details = new List<string>();
        if (hazard.Dice > 0)
        {
            details.Add($"{hazard.Dice} damage {(hazard.Dice == 1 ? "die" : "dice")}, no Defense roll");
        }
        if (hazard.Forced)
        {
            details.Add("forced movement");
        }
        if (hazard.Stops)
        {
            details.Add("stops movement");
        }
        return $"{Title(hazard.Terrain)} hazard" + (details.Count == 0 ? string.Empty : ": " + string.Join(", ", details));
    }

    private static string ConditionLabel(ConditionProjection condition) =>
        condition.Name == "Slipping" && condition.Data.Direction is { Count: 2 } direction
            ? $"Slipping {DirectionName(direction)}"
            : condition.Name is "Enraged" or "Dragon Slayer" ? $"{condition.Name} +{condition.Data.Level ?? 0}" : condition.Name;

    private static string DirectionName(IReadOnlyList<int> direction) => (direction[0], direction[1]) switch
    {
        (1, 0) => "east",
        (1, -1) => "north-east",
        (0, -1) => "north-west",
        (-1, 0) => "west",
        (-1, 1) => "south-west",
        (0, 1) => "south-east",
        _ => $"toward {direction[0]},{direction[1]}",
    };

    private static string ConditionMarker(ConditionProjection condition) => condition.Name switch
    {
        "Petrified" => "◈",
        "Entrapped" => "⊗",
        "Charmed" => "♥",
        "Pan Pipes" => "♪",
        "Stunned" => "✦",
        "Slowed" => "↓",
        "Unsteady" => "≈",
        "Slipping" => "➜",
        "Poisoned" => "◆",
        "Hibernating" => "Zz",
        "Dragon Slayer" => "⚔",
        "Enraged" => $"+{condition.Data.Level ?? 0}",
        _ => "•",
    };

    private static string Initials(string value) => string.Concat(
        value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private static string Title(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private static string Humanize(string value)
    {
        var spaced = System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
        return Title(spaced.ToLowerInvariant());
    }

    private static string ActionLabel(string kind) => kind switch
    {
        "endActivation" => "Done",
        "endTurn" => "End turn",
        _ => Humanize(kind),
    };

    private static string ModeLabel(GameMode mode) => mode switch
    {
        GameMode.VanillaPvp => "Vanilla duel",
        GameMode.Coop => "Void incursion",
        GameMode.BattleRoyale => "Battle royale",
        _ => mode.ToString(),
    };
}
