@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services

<main class="game-table">
    <header class="turn-ribbon">
        <div>
            <span class="mode-mark" aria-hidden="true">⚔</span>
            <strong>@ModeLabel(Projection.Mode)</strong>
        </div>
        <p data-testid="turn-status">@TurnStatus</p>
        <p data-testid="viewer-role" class="viewer-role">
            @(Projection.Viewer.CanCommand ? "Commanding" : "Spectating")
        </p>
    </header>

    <section class="battlefield-panel" aria-label="Game board" @onkeydown="OnBoardKey">
        <div class="board-controls" aria-label="Board view controls">
            <button type="button" aria-label="Zoom out" disabled="@(_zoom <= MinZoom)" @onclick="() => Zoom(-ZoomStep)">−</button>
            <button type="button" aria-label="Reset board view" @onclick="() => _zoom = 1">Reset</button>
            <button type="button" aria-label="Zoom in" disabled="@(_zoom >= MaxZoom)" @onclick="() => Zoom(ZoomStep)">+</button>
        </div>
        @if (_targeting is { } aiming)
        {
            <div class="targeting-banner" data-testid="targeting-banner" role="status">
                <span>@aiming.Ability: choose a target</span>
                <button type="button" data-action="cancelTargeting" @onclick="CancelTargeting">Cancel</button>
            </div>
        }
        @{ var board = BoardLayout.For(Projection.Board.Hexes); }
        <svg class="hex-board"
             role="group"
             viewBox="0 0 @Num(board.Width) @Num(board.Height)"
             width="@Num(board.Width * _zoom)"
             height="@Num(board.Height * _zoom)"
             aria-label="Battlefield, @Projection.Board.Rows columns by @Projection.Board.Columns rows">
            <defs>
                @foreach (var terrain in board.Tiles.Select(tile => tile.Hex).DistinctBy(TerrainPatternId))
                {
                    <pattern id="@TerrainPatternId(terrain)" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <rect width="1" height="1" fill="@TerrainArt.Color(terrain.Biome)" />
                        @if (CatalogImages.Resolve(ImageBaseUrl, TerrainArt.ImagePath(terrain.Biome, terrain.Terrain)) is { } terrainImage)
                        {
                            <image href="@terrainImage" width="1" height="1" preserveAspectRatio="xMidYMid slice" />
                        }
                    </pattern>
                }
                @foreach (var unit in Projection.Units)
                {
                    @if (CatalogImages.Resolve(ImageBaseUrl, unit.Image) is { } portrait)
                    {
                        <pattern id="@UnitPatternId(unit)" patternContentUnits="objectBoundingBox" width="1" height="1">
                            <image href="@portrait" width="1" height="1" preserveAspectRatio="xMidYMid slice" />
                        </pattern>
                    }
                }
            </defs>
            @foreach (var tile in board.Tiles)
            {
                var hex = tile.Hex;
                var key = HexKey(hex);
                var unit = UnitById(hex.OccupantId);
                <g role="button"
                   tabindex="0"
                   class="hex @TerrainClass(hex) @HexState(key) @(hex.OccupantId is null ? null : "occupied")"
                   data-hex="@key"
                   aria-label="@HexLabel(hex, unit)"
                   @onclick="() => SelectHex(hex)"
                   @onkeydown="args => OnHexKey(args, hex)"
                   @onmouseenter="() => Hover(hex)"
                   @onmouseleave="Unhover"
                   @onfocus="() => Hover(hex)"
                   @onblur="Unhover">
                    @if (tile.Lift > 0)
                    {
                        <path class="hex-side" d="@tile.SidePath" />
                        <path class="hex-side-edges" d="@tile.SideEdges" />
                    }
                    <polygon class="hex-top" points="@tile.TopPoints" fill="url(#@TerrainPatternId(hex))" />
                    @if (hex.Elevation != 0)
                    {
                        <polygon class="hex-shade" points="@tile.TopPoints"
                                 fill="@(hex.Elevation > 0 ? "#fff" : "#000")"
                                 fill-opacity="@Num(Math.Min(.6, Math.Abs(hex.Elevation) * .08))" />
                    }
                    <polygon class="hex-outline" points="@tile.TopPoints" />
                    @if (hex.Elevation != 0)
                    {
                        <!text class="hex-elevation"
                              x="@Num(tile.X - BoardLayout.Size * .42)" y="@Num(tile.Y - BoardLayout.Size * .5)"
                              fill="@TerrainArt.LabelColor(hex.Biome)"
                              aria-hidden="true">@(hex.Elevation > 0 ? $"+{hex.Elevation}" : hex.Elevation.ToString())</!text>
                    }
                    @if (hex.OccupantId is not null)
                    {
                        var tokenY = tile.Y + BoardLayout.Size * .1;
                        var radius = BoardLayout.Size * .42;
                        var portrait = unit is not null && CatalogImages.Resolve(ImageBaseUrl, unit.Image) is not null;
                        <g class="unit-token @SeatClass(unit?.SeatId) @(unit?.IsHero == true ? "hero" : null) @ActivationState(unit)" aria-hidden="true">
                            <g class="token-face">
                            <circle class="token-base" cx="@Num(tile.X)" cy="@Num(tokenY)" r="@Num(radius)" />
                            @if (portrait)
                            {
                                <circle cx="@Num(tile.X)" cy="@Num(tokenY)" r="@Num(radius)" fill="url(#@UnitPatternId(unit!))" />
                            }
                            else
                            {
                                <!text class="token-initials" x="@Num(tile.X)" y="@Num(tokenY)">@(unit is null ? Initials(hex.OccupantId) : Initials(unit.Name))</!text>
                            }
                            </g>
                            <circle class="token-ring" cx="@Num(tile.X)" cy="@Num(tokenY)" r="@Num(radius)" />
                            @if (ActivationState(unit) == "spent")
                            {
                                var badgeX = tile.X - radius * .75;
                                var badgeY = tokenY - radius * .75;
                                <circle class="token-spent-badge" cx="@Num(badgeX)" cy="@Num(badgeY)" r="7" />
                                <!text class="token-spent-mark" x="@Num(badgeX)" y="@Num(badgeY)">✓</!text>
                            }
                            @if (unit?.IsHero == true)
                            {
                                <!text class="token-hero" x="@Num(tile.X + radius * .85)" y="@Num(tokenY - radius * .75)">⚑</!text>
                            }
                            @if (unit is not null && unit.Effects.Any(effect => effect.Amount > 0))
                            {
                                <!text class="effect-marker buff" x="@Num(tile.X + radius * .85)" y="@Num(tokenY + radius * .55)">▲</!text>
                            }
                            @if (unit is not null && unit.Effects.Any(effect => effect.Amount < 0))
                            {
                                <!text class="effect-marker debuff" x="@Num(tile.X - radius * .85)" y="@Num(tokenY + radius * .55)">▼</!text>
                            }
                            @if (unit is not null)
                            {
                                var barWidth = radius * 1.7;
                                var barX = tile.X - barWidth / 2;
                                var barY = tokenY + radius + 2;
                                <rect class="hp-bar" x="@Num(barX)" y="@Num(barY)" width="@Num(barWidth)" height="4" />
                                <rect class="hp-fill" x="@Num(barX)" y="@Num(barY)" width="@Num(barWidth * HealthPercent(unit) / 100)" height="4" />
                            }
                        </g>
                    }
                </g>
            }
        </svg>
    </section>

    <aside class="command-rail" aria-label="Game commands">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="rail-error" role="alert">@ErrorMessage</p>
        }

        @if (Projection.PendingChoice is not null && Projection.PendingChoice.SeatId == Projection.Viewer.SeatId)
        {
            <section class="choice-prompt" role="dialog" aria-modal="false" aria-labelledby="choice-title">
                <h2 id="choice-title">@Humanize(Projection.PendingChoice.Kind)</h2>
                <p>The battle is waiting for your decision.</p>
                <div class="choice-options">
                    @foreach (var option in Projection.PendingChoice.Options)
                    {
                        <button type="button" data-choice="@option" @onclick="() => OnChoice.InvokeAsync(option)">@option</button>
                    }
                </div>
            </section>
        }
        else if (Projection.Viewer.CanCommand)
        {
            <section class="action-tray" aria-label="Your orders">
                <h2>Your orders</h2>
                @if (SelectedUnit is { } selected)
                {
                    <article class="unit-card" data-testid="selected-unit">
                        <h3>@selected.Name</h3>
                        <p class="unit-stats">
                            @foreach (var (stat, label, baseValue, effective) in StatRows(selected))
                            {
                                <span data-stat="@stat" title="@EffectSources(selected, stat)" class="@(effective > baseValue ? "raised" : effective < baseValue ? "lowered" : null)">
                                    @label @baseValue@(effective != baseValue ? $" → {effective}" : null)
                                </span>
                            }
                        </p>
                        <p>Wounds @selected.Wounds / @selected.Hp</p>
                        <AbilityList Abilities="selected.Abilities"
                                     Actions="AbilityActions(selected.UnitId)"
                                     ActiveAbility="@_targeting?.Ability"
                                     IsBusy="IsBusy"
                                     OnChoose="StartTargeting" />
                    </article>
                }
                else if (IsMyTurn)
                {
                    <p>Select one of your units on the board.</p>
                }
                @foreach (var action in Projection.LegalActions.Where(action => action.Kind is "endActivation" or "endTurn"))
                {
                    <button type="button"
                            class="action-button"
                            data-action="@action.Kind"
                            disabled="@IsBusy"
                            @onclick="() => Send(action.Kind, ActionPayload(action))">
                        @ActionLabel(action.Kind)
                    </button>
                }
            </section>
        }
        else
        {
            <section class="spectator-controls">
                <h2>Battle camera</h2>
                <button type="button" data-follow-events @onclick="() => OnFollowEvents.InvokeAsync()">
                    Follow the action
                </button>
                <p>Moving the board pauses automatic following.</p>
            </section>
        }

        @if (Projection.Viewer.CanCommand && Projection.Result is null)
        {
            <LeaveMatchControl OnLeave="OnReturnToWarRoom" />
        }

        <section class="rosters" aria-label="Armies">
            @foreach (var seat in Projection.Memberships)
            {
                <div class="roster @SeatClass(seat.SeatId)">
                    <h2>@RosterTitle(seat)</h2>
                    <ul>
                        @foreach (var unit in Projection.Units.Where(unit => unit.SeatId == seat.SeatId))
                        {
                            <li class="@RosterClass(unit)" data-roster-unit="@unit.UnitId" aria-current="@(unit.UnitId == _selectedUnitId ? "true" : null)">
                                <span>
                                    @unit.Name
                                    @switch (ActivationState(unit))
                                    {
                                        case "activating":
                                            <span class="activation-tag activating">Acting</span>
                                            break;
                                        case "spent":
                                            <span class="activation-tag spent">Activated</span>
                                            break;
                                    }
                                </span>
                                <span>@(unit.Hp - unit.Wounds)/@unit.Hp</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>

        <CombatLog Projection="Projection" Events="Events" />
    </aside>

    @if (Projection.Result is { } result)
    {
        <section class="match-end" role="dialog" aria-modal="true" aria-labelledby="match-end-title" data-testid="match-end">
            <h2 id="match-end-title">@ResultTitle(result)</h2>
            <p>@ResultSummary(result)</p>
            @if (Projection.Viewer.CanCommand)
            {
                <button type="button" data-action="returnToWarRoom" @onclick="() => OnReturnToWarRoom.InvokeAsync()">Return to war room</button>
            }
        </section>
    }
</main>

@code {
    [Parameter, EditorRequired]
    public GameProjection Projection { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<GameEvent> Events { get; set; } = [];

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? ImageBaseUrl { get; set; }

    [Parameter]
    public EventCallback<GameCommandRequest> OnCommand { get; set; }

    [Parameter]
    public EventCallback OnReturnToWarRoom { get; set; }

    [Parameter]
    public EventCallback<string> OnChoice { get; set; }

    [Parameter]
    public EventCallback OnFollowEvents { get; set; }

    private const double MinZoom = .6;
    private const double MaxZoom = 2;
    private const double ZoomStep = .2;

    private string? _selectedUnitId;
    private sealed record Targeting(string Kind, string Ability, IReadOnlyList<string> TargetHexes);

    private Targeting? _targeting;

    private static IEnumerable<(string Stat, string Label, int Base, int Effective)> StatRows(UnitProjection unit) =>
    [
        ("move", "Move", unit.Move, unit.EffectiveMove ?? unit.Move),
        ("range", "Range", unit.Range, unit.EffectiveRange ?? unit.Range),
        ("power", "Power", unit.Power, unit.EffectivePower ?? unit.Power),
        ("defense", "Defense", unit.Defense, unit.EffectiveDefense ?? unit.Defense),
    ];

    private static string? EffectSources(UnitProjection unit, string stat)
    {
        var sources = unit.Effects
            .Where(effect => effect.Stat == stat)
            .Select(effect => $"{effect.Name} {(effect.Amount > 0 ? "+" : "")}{effect.Amount} {(effect.Expires == "endOfTurn" ? "until end of turn" : "until your next turn")}")
            .ToList();
        return sources.Count == 0 ? null : string.Join("; ", sources);
    }

    private IReadOnlyList<LegalAction> AbilityActions(string unitId) => Projection.LegalActions
        .Where(action => action.UnitId == unitId && (action.Kind is "specialAttack" or "useAbility"))
        .ToList();

    private void StartTargeting(LegalAction action)
    {
        _targeting = _targeting?.Ability == action.Ability ? null : new Targeting(action.Kind, action.Ability!, action.TargetHexes);
    }
    private string? _hoveredUnitId;
    private double _zoom = 1;

    protected override void OnParametersSet()
    {
        if (_selectedUnitId is not null && !Selectable(_selectedUnitId))
        {
            _selectedUnitId = null;
        }
        if (_selectedUnitId is null && Projection.Turn.ActiveUnitId is { } active && Selectable(active))
        {
            _selectedUnitId = active;
        }
        if (_targeting is { } aiming && !AbilityActions(_selectedUnitId ?? string.Empty).Any(action => action.Ability == aiming.Ability))
        {
            _targeting = null;
        }
        if (ErrorMessage != _lastError)
        {
            if (!string.IsNullOrEmpty(ErrorMessage))
            {
                _targeting = null;
            }
            _lastError = ErrorMessage;
        }
    }

    private bool IsMyTurn => Projection.Viewer.SeatId is not null && Projection.Turn.ActiveSeatId == Projection.Viewer.SeatId;

    private UnitProjection? SelectedUnit => UnitById(_selectedUnitId);

    private string? SelectedHex => Projection.Board.Hexes
        .Where(hex => _selectedUnitId is not null && hex.OccupantId == _selectedUnitId)
        .Select(HexKey)
        .FirstOrDefault();

    private IReadOnlyList<string> FocusHexes =>
        Events.Reverse().FirstOrDefault(gameEvent => gameEvent.FocusHexes.Count > 0)?.FocusHexes ?? [];

    private string TurnStatus
    {
        get
        {
            var round = $"Round {Projection.Turn.Round}";
            if (Projection.Result is not null)
            {
                return $"{round} · The battle is decided";
            }
            if (Projection.Turn.ActiveSeatId is null)
            {
                return round;
            }
            if (IsMyTurn)
            {
                return $"{round} · Your turn · {Projection.Turn.ActivationsRemaining} {(Projection.Turn.ActivationsRemaining == 1 ? "activation" : "activations")}";
            }
            return Projection.Viewer.CanCommand ? $"{round} · Opponent's turn" : $"{round} · {SeatName(Projection.Turn.ActiveSeatId)}'s turn";
        }
    }

    private bool Selectable(string unitId) =>
        Projection.Viewer.CanCommand &&
        Projection.LegalActions.Any(action => action.UnitId == unitId && (action.Kind is "moveUnit" or "attackUnit" or "specialAttack" or "useAbility"));

    private IReadOnlyList<string> Targets(string kind) => _selectedUnitId is null
        ? []
        : Projection.LegalActions
            .Where(action => action.Kind == kind && action.UnitId == _selectedUnitId)
            .SelectMany(action => action.TargetHexes)
            .ToList();

    private async Task SelectHex(HexProjection hex)
    {
        if (!Projection.Viewer.CanCommand || IsBusy)
        {
            return;
        }
        if (_targeting is { } aiming && _selectedUnitId is { } caster)
        {
            var aimed = HexKey(hex);
            if (aiming.TargetHexes.Contains(aimed) && hex.OccupantId is { } targetId)
            {
                _targeting = null;
                if (aiming.Kind == "specialAttack")
                {
                    await Send("specialAttack", new { unitId = caster, ability = aiming.Ability, targetUnitIds = new[] { targetId } });
                }
                else
                {
                    await Send("useAbility", new { unitId = caster, ability = aiming.Ability, targetUnitId = targetId });
                }
            }
            return;
        }
        var key = HexKey(hex);
        if (_selectedUnitId is { } unitId)
        {
            if (Targets("moveUnit").Contains(key))
            {
                await Send("moveUnit", new { unitId, to = key });
                return;
            }
            if (Targets("attackUnit").Contains(key) && hex.OccupantId is { } targetUnitId)
            {
                await Send("attackUnit", new { unitId, targetUnitId });
                return;
            }
        }
        _selectedUnitId = hex.OccupantId is { } occupant && Selectable(occupant) ? occupant : null;
    }

    private string? _hoveredHex;
    private string? _lastError;

    private void Hover(HexProjection hex)
    {
        _hoveredUnitId = hex.OccupantId;
        _hoveredHex = HexKey(hex);
    }

    private void Unhover()
    {
        _hoveredUnitId = null;
        _hoveredHex = null;
    }

    private void CancelTargeting() => _targeting = null;

    private void OnBoardKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _targeting = null;
        }
    }

    private bool TargetsAlly(string key) =>
        UnitById(Projection.Board.Hexes.FirstOrDefault(hex => HexKey(hex) == key)?.OccupantId)?.SeatId == Projection.Viewer.SeatId;

    private IReadOnlyList<string> SplashHexes =>
        _targeting?.Ability == "Fireball" && _hoveredHex is { } hovered && _targeting.TargetHexes.Contains(hovered)
            ? HexMath.Neighbours(hovered)
            : [];

    private Task Send(string kind, object payload) => OnCommand.InvokeAsync(new GameCommandRequest(kind, payload));

    private static object ActionPayload(LegalAction action) =>
        action.Kind == "endTurn" ? new { } : new { unitId = action.UnitId };

    private string? HexState(string key)
    {
        if (key == SelectedHex)
        {
            return "selected";
        }
        if (_targeting is { } aiming)
        {
            var state = aiming.TargetHexes.Contains(key) ? (TargetsAlly(key) ? "ally-target" : "ability-target") : null;
            return SplashHexes.Contains(key) ? $"{state} splash".Trim() : state;
        }
        if (Targets("attackUnit").Contains(key))
        {
            return "attackable";
        }
        if (Targets("moveUnit").Contains(key))
        {
            return "reachable";
        }
        return FocusHexes.Contains(key) ? "focus" : null;
    }

    private UnitProjection? UnitById(string? unitId) =>
        unitId is null ? null : Projection.Units.FirstOrDefault(unit => unit.UnitId == unitId);

    private string? SeatClass(string? seatId)
    {
        var seat = Projection.Memberships.FirstOrDefault(member => member.SeatId == seatId);
        return seat is null ? null : $"seat-{seat.SeatIndex}";
    }

    private string SeatName(string seatId)
    {
        if (seatId == Projection.Viewer.SeatId)
        {
            return "You";
        }
        if (Projection.Viewer.Role == "player")
        {
            return "Rival";
        }
        var seat = Projection.Memberships.FirstOrDefault(member => member.SeatId == seatId);
        return seat is null ? "Commander" : $"Commander {seat.SeatIndex}";
    }

    private string RosterTitle(MembershipProjection seat) =>
        seat.SeatId == Projection.Viewer.SeatId
            ? "Your army"
            : Projection.Viewer.Role == "player" ? "Rival army" : $"Commander {seat.SeatIndex}";

    private string ResultTitle(GameResult result) =>
        result.WinningSeatId == Projection.Viewer.SeatId
            ? "Victory"
            : Projection.Viewer.Role == "player" ? "Defeat" : $"{SeatName(result.WinningSeatId ?? string.Empty)} wins";

    private string ResultSummary(GameResult result) =>
        !Projection.Viewer.CanCommand
            ? "The losing army has fallen."
            : result.WinningSeatId == Projection.Viewer.SeatId ? "Every enemy unit has fallen." : "Your army has fallen.";

    /// <summary>"activating" for the unit mid-activation, "spent" once it has finished acting this turn.</summary>
    private string? ActivationState(UnitProjection? unit) =>
        unit is null || unit.Hex is null || !unit.ActivatedThisTurn ? null
        : unit.UnitId == Projection.Turn.ActiveUnitId ? "activating"
        : "spent";

    private string? RosterClass(UnitProjection unit)
    {
        var classes = new[]
        {
            unit.Hex is null ? "defeated" : null,
            unit.UnitId == _selectedUnitId ? "selected" : null,
            unit.UnitId == _hoveredUnitId ? "highlighted" : null,
            ActivationState(unit),
        }.OfType<string>().ToList();
        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private void Zoom(double delta) => _zoom = Math.Clamp(Math.Round(_zoom + delta, 1), MinZoom, MaxZoom);

    private Task OnHexKey(KeyboardEventArgs args, HexProjection hex) =>
        args.Key is "Enter" or " " ? SelectHex(hex) : Task.CompletedTask;

    private static string Num(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string TerrainPatternId(HexProjection hex) => "bb-terrain-" + SafeId($"{hex.Biome}-{hex.Terrain}");

    private static string UnitPatternId(UnitProjection unit) => "bb-unit-" + SafeId(unit.UnitId);

    private static string SafeId(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value.ToLowerInvariant(), "[^a-z0-9-]", "-");

    private static int HealthPercent(UnitProjection unit) =>
        unit.Hp <= 0 ? 0 : (unit.Hp - unit.Wounds) * 100 / unit.Hp;

    private static string HexKey(HexProjection hex) => $"{hex.Q},{hex.R}";

    private static string TerrainClass(HexProjection hex) =>
        $"terrain-{hex.Biome.ToLowerInvariant()}-{hex.Terrain.ToLowerInvariant().Replace(' ', '-')}";

    private string HexLabel(HexProjection hex, UnitProjection? unit) =>
        $"{Title(hex.Biome)} {hex.Terrain}, elevation {hex.Elevation}" +
        (hex.OccupantId is null ? string.Empty : $", occupied by {unit?.Name ?? hex.OccupantId}") +
        (unit is null || unit.Effects.Count == 0 ? string.Empty : ", " + string.Join(", ", unit.Effects.Select(effect => $"{effect.Name} {(effect.Amount > 0 ? "+" : "")}{effect.Amount} {effect.Stat}"))) +
        ActivationState(unit) switch
        {
            "activating" => ", activating",
            "spent" => ", already activated this turn",
            _ => string.Empty,
        };

    private static string Initials(string value) => string.Concat(
        value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private static string Title(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private static string Humanize(string value)
    {
        var spaced = System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
        return Title(spaced.ToLowerInvariant());
    }

    private static string ActionLabel(string kind) => kind switch
    {
        "endActivation" => "End activation",
        "endTurn" => "End turn",
        _ => Humanize(kind),
    };

    private static string ModeLabel(GameMode mode) => mode switch
    {
        GameMode.VanillaPvp => "Vanilla duel",
        GameMode.Coop => "Void incursion",
        GameMode.BattleRoyale => "Battle royale",
        _ => mode.ToString(),
    };
}
