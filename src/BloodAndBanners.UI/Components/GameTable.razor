@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<main class="game-table">
    <MatchMenu GameId="@Projection.GameId"
               InviteBaseUri="@InviteBaseUri"
               IsSpectator="@(!Projection.Viewer.CanCommand)"
               IsFinished="@(Projection.Result is not null)"
               OnLeave="OnReturnToWarRoom"
               Details="@([ModeLabel(Projection.Mode), Projection.Viewer.CanCommand ? "Commanding" : "Spectating"])" />
    <header class="turn-ribbon @RibbonState" data-turn="@RibbonState">
        <div class="ribbon-mode">
            <span class="mode-mark" aria-hidden="true">⚔</span>
            <strong>@ModeLabel(Projection.Mode)</strong>
        </div>
        <p class="turn-status" data-testid="turn-status">
            @if (ActiveEmblem is { } activeEmblem)
            {
                <img class="turn-emblem" data-testid="turn-emblem" src="@activeEmblem" alt="" />
            }
            <span>@TurnStatus</span>
        </p>
        <div class="ribbon-end">
            @if (ShowBeginButton)
            {
                <button type="button"
                        class="ribbon-end-turn"
                        data-action="start-game"
                        disabled="@(!LobbyRules.CanStart(Projection) || IsBusy)"
                        @onclick="() => OnStart.InvokeAsync()">
                    Begin the incursion
                </button>
            }
            @if (ShowUnleashButton)
            {
                <button type="button"
                        class="ribbon-end-turn"
                        data-action="confirmSetup"
                        disabled="@(!Projection.LegalActions.Any(action => action.Kind == "confirmSetup") || IsBusy)"
                        @onclick='() => Send("confirmSetup", new { })'>
                    Unleash the horde
                </button>
            }
            @foreach (var action in Projection.LegalActions.Where(action => action.Kind == "endTurn"))
            {
                <button type="button"
                        class="ribbon-end-turn"
                        data-action="@action.Kind"
                        disabled="@IsBusy"
                        @onclick="() => Send(action.Kind, ActionPayload(action))">
                    @ActionLabel(action.Kind)
                </button>
            }
            <p data-testid="viewer-role" class="viewer-role">
                @(Projection.Viewer.CanCommand ? "Commanding" : "Spectating")
            </p>
        </div>
    </header>

    <section class="battlefield-panel" aria-label="Game board" @onkeydown="OnBoardKey">
        <div class="board-controls" aria-label="Board view controls">
            <button type="button" aria-label="Zoom out" disabled="@(_viewport.Scale <= _viewport.MinimumScale)" @onclick="() => ZoomViewport(1 / ZoomFactor)">−</button>
            <button type="button" aria-label="Fit whole battlefield" @onclick="FitViewport">Fit</button>
            <button type="button" aria-label="Zoom in" disabled="@(_viewport.Scale >= BoardViewport.MaxScale)" @onclick="() => ZoomViewport(ZoomFactor)">+</button>
            <button type="button"
                    class="follow-toggle"
                    data-follow-events
                    aria-pressed="@(_followEvents ? "true" : "false")"
                    title="@(_followEvents ? "Auto: the board follows the action. Drag the board or click to stop." : "Auto off: click to follow the action again.")"
                    @onclick="ToggleFollowing">Auto</button>
            <span class="viewport-status" data-testid="viewport-status" role="status">Zoom @ZoomPercent%</span>
        </div>
        @if (_targeting is { } aiming)
        {
            <div class="targeting-banner" data-testid="targeting-banner" role="status">
                <span>@BannerText(aiming)</span>
                @if (Teleporting && _teleportUnitId is not null)
                {
                    <button type="button" data-action="teleportBack" @onclick="() => _teleportUnitId = null">Back</button>
                }
                @if (Chaining)
                {
                    <span>@_chain.Count / @ChainMaxTargets picked</span>
                    <button type="button" data-action="strikeChain" disabled="@(_chain.Count == 0 || IsBusy)" @onclick="StrikeChain">Strike</button>
                }
                @if (MultiSelecting)
                {
                    <span>@_pickedTargets.Count / @aiming.Selection!.MaxTargets picked</span>
                    <button type="button" data-action="undoTarget" disabled="@(_pickedTargets.Count == 0 || IsBusy)" @onclick="UndoTarget">Undo</button>
                    <button type="button" data-action="confirmTargets" disabled="@(_pickedTargets.Count == 0 || IsBusy)" @onclick="ConfirmTargets">Strike</button>
                }
                <button type="button" data-action="cancelTargeting" @onclick="CancelTargeting">Cancel</button>
            </div>
        }
        @if (PreviewedMovement is { } movement)
        {
            <div class="movement-preview" data-testid="movement-preview" role="status">
                <strong>@movement.Path.Count-step path</strong>
                <span>@MovementRisk(movement)</span>
            </div>
        }
        @{ var boardIndex = Index; _view = BuildView(); }
        <svg class="hex-board board-interaction-surface"
             @ref="_boardElement"
             role="group"
             viewBox="@ViewportViewBox"
             preserveAspectRatio="xMidYMid meet"
             @onwheel="OnWheel"
             @onwheel:preventDefault="true"
             @onpointerdown="args => BeginBoardPointer(args, true)"
             @onpointermove="MoveBoardPointer"
             @onpointerup="EndBoardPointer"
             @onpointercancel="EndBoardPointer"
             aria-label="Battlefield, @Projection.Board.Rows columns by @Projection.Board.Columns rows">
            <defs>
                @foreach (var (patternId, terrain) in boardIndex.TerrainPatterns)
                {
                    <pattern id="@patternId" patternContentUnits="objectBoundingBox" width="1" height="1">
                        <rect width="1" height="1" fill="@TerrainArt.Color(terrain.Biome)" />
                        @if (CatalogImages.Resolve(ImageBaseUrl, TerrainArt.ImagePath(terrain.Biome, terrain.Terrain, TerrainArt.Variant(terrain.Q, terrain.R))) is { } terrainImage)
                        {
                            <image href="@terrainImage" width="1" height="1" preserveAspectRatio="xMidYMid slice" />
                        }
                    </pattern>
                }
            </defs>
            @if (PreviewedMovement is { } preview)
            {
                @for (var step = 0; step < preview.Path.Count - 1; step++)
                {
                    var from = boardIndex.TileByKey.GetValueOrDefault(preview.Path[step]);
                    var to = boardIndex.TileByKey.GetValueOrDefault(preview.Path[step + 1]);
                    if (from is not null && to is not null)
                    {
                        <line class="movement-path-connector"
                              data-path-connector="@(step + 1)"
                              x1="@Num(from.X)" y1="@Num(from.Y)"
                              x2="@Num(to.X)" y2="@Num(to.Y)" />
                    }
                }
            }
            @foreach (var boardTile in boardIndex.Tiles)
            {
                var (tile, key, patternId) = (boardTile.Tile, boardTile.Key, boardTile.PatternId);
                var hex = tile.Hex;
                var unit = UnitById(hex.OccupantId);
                @* Handlers and label are cached per projection: fresh closures would make Blazor re-bind every hex's events on each render *@
                <g role="button"
                   tabindex="0"
                   class="hex @boardTile.TerrainClass @HexState(key) @(hex.OccupantId is null ? null : "occupied")"
                   data-hex="@key"
                   aria-label="@(boardTile.Label ??= HexLabel(hex, unit))"
                   @onclick="boardTile.Select"
                   @onpointerdown="boardTile.PointerDown"
                   @onpointerdown:stopPropagation="true"
                   @onkeydown="boardTile.KeyDown"
                   @onmouseenter="boardTile.Hover"
                   @onmouseleave="Unhover"
                   @onfocus="boardTile.Hover"
                   @onblur="Unhover">
                    @if (tile.Lift > 0)
                    {
                        <path class="hex-side" d="@tile.SidePath" />
                        <path class="hex-side-edges" d="@tile.SideEdges" />
                    }
                    <polygon class="hex-top" points="@tile.TopPoints" fill="url(#@patternId)" />
                    @if (hex.Elevation != 0)
                    {
                        <polygon class="hex-shade" points="@tile.TopPoints"
                                 fill="@(hex.Elevation > 0 ? "#fff" : "#000")"
                                 fill-opacity="@Num(Math.Min(.6, Math.Abs(hex.Elevation) * .08))" />
                    }
                    <polygon class="hex-outline" points="@tile.TopPoints" />
                    @if (PathStep(key) is { } pathStep)
                    {
                        <g class="movement-path-marker" data-path-step="@pathStep" aria-hidden="true">
                            <circle cx="@Num(tile.X)" cy="@Num(tile.Y)" r="10" />
                            <!text x="@Num(tile.X)" y="@Num(tile.Y)">@pathStep</!text>
                        </g>
                    }
                    @if (HazardAt(key) is { } hazard)
                    {
                        <!text class="movement-hazard-marker"
                              data-hazard="@hazard.Terrain"
                              x="@Num(tile.X + BoardLayout.Size * .42)"
                              y="@Num(tile.Y + BoardLayout.Size * .42)"
                              aria-hidden="true">!</!text>
                    }
                    @if (hex.Elevation != 0)
                    {
                        <!text class="hex-elevation"
                              x="@Num(tile.X - BoardLayout.Size * .42)" y="@Num(tile.Y - BoardLayout.Size * .5)"
                              fill="@TerrainArt.LabelColor(hex.Biome)"
                              aria-hidden="true">@(hex.Elevation > 0 ? $"+{hex.Elevation}" : hex.Elevation.ToString())</!text>
                    }
                    @if (hex.OccupantId is { } occupant && PickedIndex(occupant) is >= 0 and var link)
                    {
                        <!text class="chain-mark" x="@Num(tile.X + BoardLayout.Size * .42)" y="@Num(tile.Y - BoardLayout.Size * .5)">@(link + 1)</!text>
                    }
                    @if (_view.Push.Contains(key))
                    {
                        <!text class="push-mark" x="@Num(tile.X)" y="@Num(tile.Y)">»</!text>
                    }
                    @if (hex.OccupantId is not null)
                    {
                        // The figure is a full hex tall, its feet level with the bottom of the seat-coloured plate drawn
                        // over them, so its head may rise into the hex behind.
                        var hexTop = tile.Y - HexHalfHeight;
                        var plateWidth = BoardLayout.Size * .92;
                        var plateHeight = 11d;
                        var plateX = tile.X - plateWidth / 2;
                        var plateY = tile.Y + HexHalfHeight - 3 - plateHeight;
                        var figureHeight = 2 * HexHalfHeight;
                        var figureTop = plateY + plateHeight - figureHeight;
                        var figureWidth = BoardLayout.Size * 1.9;
                        var figureMidY = figureTop + figureHeight / 2;
                        var portrait = unit is null ? null : TokenImage(unit);
                        <g class="unit-token @SeatClass(unit?.SeatId) @(unit is not null && IsCoop && unit.SeatId != Projection.Viewer.SeatId && SideOf(unit) == ViewerSide ? "ally" : null) @(unit?.IsHero == true ? "hero" : null) @ActivationState(unit)" aria-hidden="true">
                            @if (key == _view.SpotlitHex)
                            {
                                <circle class="token-spotlight" cx="@Num(tile.X)" cy="@Num(tile.Y)" r="@Num(HexHalfHeight - 3)" />
                            }
                            <g class="token-face">
                            @if (portrait is not null)
                            {
                                <image class="token-figure" href="@portrait"
                                       x="@Num(tile.X - figureWidth / 2)" y="@Num(figureTop)" width="@Num(figureWidth)" height="@Num(figureHeight)"
                                       preserveAspectRatio="xMidYMax meet" />
                            }
                            else
                            {
                                <!text class="token-initials" x="@Num(tile.X)" y="@Num(figureMidY)">@(unit is null ? Initials(hex.OccupantId) : Initials(unit.Name))</!text>
                            }
                            </g>
                            <rect class="token-plate" x="@Num(plateX)" y="@Num(plateY)" width="@Num(plateWidth)" height="@Num(plateHeight)" rx="2" />
                            @if (unit is not null)
                            {
                                var barWidth = plateWidth - 6;
                                <rect class="hp-bar" x="@Num(plateX + 3)" y="@Num(plateY + 3)" width="@Num(barWidth)" height="@Num(plateHeight - 6)" />
                                <rect class="hp-fill" x="@Num(plateX + 3)" y="@Num(plateY + 3)" width="@Num(barWidth * HealthPercent(unit) / 100)" height="@Num(plateHeight - 6)" />
                            }
                            @if (ActivationState(unit) == "spent")
                            {
                                var badgeX = tile.X - plateWidth / 2;
                                var badgeY = hexTop + 9;
                                <circle class="token-spent-badge" cx="@Num(badgeX)" cy="@Num(badgeY)" r="7" />
                                <!text class="token-spent-mark" x="@Num(badgeX)" y="@Num(badgeY)">✓</!text>
                            }
                            @if (unit?.IsHero == true)
                            {
                                <!text class="token-hero" x="@Num(tile.X + plateWidth / 2)" y="@Num(hexTop + 9)">⚑</!text>
                            }
                            @if (unit is not null && unit.Effects.Any(effect => effect.Amount > 0))
                            {
                                <!text class="effect-marker buff" x="@Num(tile.X + plateWidth / 2 + 2)" y="@Num(figureMidY + 8)">▲</!text>
                            }
                            @if (unit is not null && unit.Effects.Any(effect => effect.Amount < 0))
                            {
                                <!text class="effect-marker debuff" x="@Num(tile.X - plateWidth / 2 - 2)" y="@Num(figureMidY + 8)">▼</!text>
                            }
                            @if (unit is not null)
                            {
                                @for (var conditionIndex = 0; conditionIndex < unit.Conditions.Count; conditionIndex++)
                                {
                                    var condition = unit.Conditions[conditionIndex];
                                    <!text class="condition-marker condition-@SafeId(condition.Name)"
                                          data-condition-marker="@condition.Name"
                                          x="@Num(tile.X + (conditionIndex - (unit.Conditions.Count - 1) / 2d) * 13)"
                                          y="@Num(hexTop - 4)"
                                          aria-hidden="true">@ConditionMarker(condition)</!text>
                                }
                            }
                        </g>
                    }
                </g>
            }
        </svg>
        @if (_confirmingMovement is { } confirmation)
        {
            <section class="movement-confirmation"
                     data-testid="movement-confirmation"
                     role="dialog"
                     aria-modal="false"
                     aria-labelledby="movement-confirmation-title">
                <h2 id="movement-confirmation-title">Enter dangerous terrain?</h2>
                <p>@MovementRisk(confirmation)</p>
                <div>
                    <button type="button" data-action="cancelMovement" disabled="@IsBusy" @onclick="CancelMovement">Cancel</button>
                    <button type="button" data-action="confirmMovement" disabled="@IsBusy" @onclick="ConfirmMovement">Confirm move</button>
                </div>
            </section>
        }
    </section>

    <aside class="command-rail @(_railOpen ? "rail-open" : null)" aria-label="Game commands">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="rail-error" role="alert">@ErrorMessage</p>
        }

        @if (InSetup)
        {
            <VoidLordSetup Setup="Projection.Setup!"
                           IsVoidLord="SeatNames.IsVoidLord(Projection, Projection.Viewer.SeatId)"
                           SelectedMonster="@_selectedMonster"
                           IsBusy="IsBusy"
                           ImageBaseUrl="@ImageBaseUrl"
                           MonstersPlaced="Projection.Units.Count"
                           OnSelectMonster="SelectMonster"
                           InWarRoom="@(Projection.Lifecycle == GameLifecycle.Lobby)"
                           ViewerReady="@(Projection.Memberships.FirstOrDefault(member => member.SeatId == Projection.Viewer.SeatId)?.Ready ?? false)"
                           StartNote="@StartNote"
                           OnReadyChanged="OnReadyChanged"
                           OnBackToWarRoom="OnBackToWarRoom" />
        }

        @if (Projection.PendingChoice is { Kind: "moonlightGlare" } glare && glare.SeatId == Projection.Viewer.SeatId)
        {
            <section class="choice-prompt" role="dialog" aria-modal="false" aria-labelledby="choice-title" data-testid="glare-prompt">
                <h2 id="choice-title">Moonlight Glare</h2>
                <p>@(UnitById(glare.UnitId)?.Name ?? "Your Duelist") may re-roll one @glare.Side die.</p>
                <div class="choice-dice">
                    @for (var index = 0; index < glare.Faces.Count; index++)
                    {
                        var option = $"reroll:{index}";
                        var face = glare.Faces[index];
                        <button type="button"
                                class="die face-@face"
                                data-choice="@option"
                                aria-label="Re-roll @glare.Side die @(index + 1) (@face)"
                                disabled="@(!glare.Options.Contains(option) || IsBusy)"
                                @onclick="() => Resolve(glare.ChoiceId, option)">@FaceSymbol(face)</button>
                    }
                </div>
                <button type="button" data-choice="keep" disabled="@IsBusy" @onclick='() => Resolve(glare.ChoiceId, "keep")'>Keep the roll</button>
            </section>
        }
        else if (Projection.PendingChoice is { Kind: "iceCollision" } ice && ice.SeatId == Projection.Viewer.SeatId)
        {
            <section class="choice-prompt ice-choice" role="dialog" aria-modal="false" aria-labelledby="ice-choice-title" data-testid="ice-choice">
                <h2 id="ice-choice-title">Ice collision</h2>
                <p>Your sliding unit has met an ally. Choose how it continues.</p>
                <div class="choice-options">
                    @if (ice.Options.Contains("continue"))
                    {
                        <button type="button" data-choice="continue" disabled="@IsBusy" @onclick='() => ResolveIce(ice, "continue")'>Continue</button>
                    }
                    @if (ice.Options.Contains("stop"))
                    {
                        <button type="button" data-choice="stop" disabled="@IsBusy" @onclick='() => ResolveIce(ice, "stop")'>Stop</button>
                    }
                    @if (ice.Options.Any(option => option.StartsWith("swing:", StringComparison.Ordinal)))
                    {
                        <button type="button" data-action="chooseSwing" aria-pressed="@_swingChoice" disabled="@IsBusy" @onclick="ChooseSwing">Swing</button>
                    }
                </div>
                @if (_swingChoice)
                {
                    <p role="status">Choose one of the highlighted exit hexes.</p>
                }
            </section>
        }
        else if (Projection.PendingChoice is { Kind: "panPipes" or "skyToss" } control && control.SeatId == Projection.Viewer.SeatId)
        {
            <section class="choice-prompt control-choice" role="dialog" aria-modal="false" aria-labelledby="control-choice-title" data-testid="control-choice">
                <h2 id="control-choice-title">@ControlChoiceTitle(control.Kind)</h2>
                <p>@(control.Kind == "panPipes" ? "Choose a highlighted ally for the attacker to strike instead." : "Choose a highlighted landing hex. The victim takes 3 fall-damage dice without Defense, plus any landing hazards.")</p>
                <div class="choice-options">
                    @foreach (var option in control.Options)
                    {
                        <button type="button" data-choice="@option" disabled="@IsBusy" @onclick="() => Resolve(control.ChoiceId, option)">@ControlChoiceLabel(control, option)</button>
                    }
                </div>
            </section>
        }
        else if (Projection.PendingChoice is not null && Projection.PendingChoice.SeatId == Projection.Viewer.SeatId)
        {
            <section class="choice-prompt" role="dialog" aria-modal="false" aria-labelledby="choice-title">
                <h2 id="choice-title">@Humanize(Projection.PendingChoice.Kind)</h2>
                <p>The battle is waiting for your decision.</p>
                <div class="choice-options">
                    @foreach (var option in Projection.PendingChoice.Options)
                    {
                        <button type="button" data-choice="@option" @onclick="() => Resolve(Projection.PendingChoice.ChoiceId, option)">@option</button>
                    }
                </div>
            </section>
        }
        else if (Projection.PendingChoiceSummary is { } waitingOn && Projection.Viewer.CanCommand)
        {
            <section class="choice-waiting" data-testid="choice-waiting" role="status">
                <h2>@ControlChoiceTitle(waitingOn.Kind)</h2>
                <p>Waiting for your opponent's decision…</p>
                @if ((waitingOn.Kind is "" or "moonlightGlare") && Projection.LegalActions.Any(action => action.Kind == "resolveChoice"))
                {
                    <button type="button" data-action="keepForThem" disabled="@IsBusy" @onclick='() => Resolve(waitingOn.ChoiceId, "keep")'>Keep the roll for them</button>
                }
            </section>
        }
        else if (Projection.Viewer.CanCommand || SelectedUnit is not null)
        {
            <section class="action-tray" aria-label="Your orders">
                @if (ActingUnit is { } acting)
                {
                    <div class="active-unit-head" data-testid="active-unit">
                        <h2>Active Unit: <button type="button" class="active-unit-name" data-focus-active disabled="@(acting.Hex is null)"
                                                     title="@(acting.Hex is null ? null : "Show on the battlefield")" @onclick="() => FocusUnit(acting)">@acting.Name</button></h2>
                        @foreach (var action in Projection.LegalActions.Where(action => action.Kind == "endActivation"))
                        {
                            <button type="button"
                                    class="action-button"
                                    data-action="@action.Kind"
                                    disabled="@IsBusy"
                                    @onclick="() => Send(action.Kind, ActionPayload(action))">
                                @ActionLabel(action.Kind)
                            </button>
                        }
                    </div>
                }
                else if (IsMyTurn)
                {
                    <p class="turn-prompt" data-testid="turn-prompt">Your turn: @ActivationsLeft activations remaining@(MustActivateHero ? " (must be hero)" : ""). Select one of your units on the board.</p>
                }
                @if (SelectedUnit is { } selected)
                {
                    <article class="unit-card" data-testid="selected-unit">
                        @if (selected.UnitId != ActingUnit?.UnitId)
                        {
                            <h3>
                                @if (selected.SeatId != Projection.Viewer.SeatId
                                    && Projection.Armies?.GetValueOrDefault(selected.SeatId) is { } army
                                    && CatalogImages.Resolve(ImageBaseUrl, army.Emblem) is { } emblem)
                                {
                                    <img class="unit-army-emblem" src="@emblem" alt="@army.Name" />
                                }
                                @selected.Name
                            </h3>
                        }
                        <p class="unit-stats">
                            @foreach (var (stat, label, baseValue, effective) in StatRows(selected))
                            {
                                <span data-stat="@stat" title="@EffectSources(selected, stat)" class="@(effective > baseValue ? "raised" : effective < baseValue ? "lowered" : null)">
                                    <StatIcon Label="@label" />@baseValue@(effective != baseValue ? $" → {effective}" : null)
                                </span>
                            }
                            <span data-stat="health" aria-label="@(RemainingHp(selected) + " HP")"><StatIcon Label="HP" />@RemainingHp(selected)</span>
                        </p>
                        @foreach (var condition in selected.Conditions)
                        {
                            var summary = ConditionText.Summary(condition.Name, condition.Data.PowerPenalty, condition.Data.Level);
                            <p class="unit-condition" data-condition="@condition.Name">@ConditionLabel(condition) — @(string.IsNullOrEmpty(summary) ? null : summary + ", ")@ConditionText.Expiry(condition.Expires, condition.Name)</p>
                        }
                        <AbilityList Abilities="selected.Abilities"
                                     Actions="AbilityActions(selected.UnitId)"
                                     ActiveAbility="@_targeting?.Ability"
                                     IsBusy="IsBusy"
                                     OnChoose="StartTargeting" />
                        @if (selected.InactiveAbilities.Count > 0)
                        {
                            <p class="inactive-abilities" data-testid="inactive-abilities">Not yet in play: @string.Join(", ", selected.InactiveAbilities.Select(ability => ability.Name))</p>
                        }
                    </article>
                }
            </section>
        }

        @if (!InSetup)
        {
            var recent = CombatLogFormatter.Recent(Events, Projection, 3);
            <section class="recent-log @(ShowsUnitCard ? "with-unit-card" : null)" aria-label="Latest in the battle" data-testid="recent-log">
                @if (recent.Count == 0)
                {
                    <p>No blows struck yet.</p>
                }
                else
                {
                    <ol>
                        @foreach (var line in recent)
                        {
                            <li data-event="@line.Kind">@line.Text</li>
                        }
                    </ol>
                }
            </section>
        }

        @if (_railOpen)
        {
            <div class="rail-backdrop" data-testid="rail-backdrop" @onclick="() => _railOpen = false"></div>
        }
        @{ var railSeats = Projection.Memberships.OrderByDescending(seat => seat.SeatId == Projection.Viewer.SeatId).ToList(); }
        @{ var railTab = ActiveRailTab(railSeats); }
        <div class="rail-tabs" role="tablist" aria-label="Armies and battle log">
            @foreach (var seat in railSeats)
            {
                var tabEmblem = CatalogImages.Resolve(ImageBaseUrl, Projection.Armies?.GetValueOrDefault(seat.SeatId)?.Emblem);
                <button type="button" role="tab" class="rail-tab @SeatClass(seat.SeatId)" data-rail-tab="@seat.SeatId"
                        id="rail-tab-@seat.SeatId" aria-controls="rail-panel-@seat.SeatId"
                        aria-selected="@(railTab == seat.SeatId ? "true" : "false")" tabindex="@(railTab == seat.SeatId ? 0 : -1)"
                        title="@RosterTitle(seat)" aria-label="@RosterTitle(seat)" @onclick="() => ToggleRailTab(seat.SeatId)">
                    @if (tabEmblem is not null)
                    {
                        <img src="@tabEmblem" alt="" />
                    }
                    else
                    {
                        <span class="rail-tab-initial" aria-hidden="true">@RosterTitle(seat)[..1]</span>
                    }
                </button>
            }
            <button type="button" role="tab" class="rail-tab log-tab" data-rail-tab="log"
                    id="rail-tab-log" aria-controls="rail-panel-log"
                    aria-selected="@(railTab == LogTab ? "true" : "false")" tabindex="@(railTab == LogTab ? 0 : -1)"
                    title="Battle log" aria-label="Battle log" @onclick="() => ToggleRailTab(LogTab)">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 3h10a2 2 0 0 1 2 2v13a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-1h11v1a1 1 0 0 0 2 0V5H6z" />
                    <path d="M8 7h7v1.6H8zM8 10.5h7v1.6H8zM8 14h5v1.6H8z" />
                </svg>
            </button>
        </div>

        <section class="rosters" aria-label="Armies" hidden="@(railTab == LogTab)">
            @foreach (var seat in railSeats)
            {
                <div class="roster @SeatClass(seat.SeatId)" role="tabpanel" id="rail-panel-@seat.SeatId" aria-labelledby="rail-tab-@seat.SeatId" hidden="@(railTab != seat.SeatId)">
                    @{ var army = Projection.Armies?.GetValueOrDefault(seat.SeatId); }
                    <div class="roster-head">
                        <h2>@RosterTitle(seat)</h2>
                        @if (army is not null)
                        {
                            <span class="army-name">@army.Name</span>
                        }
                    </div>
                    <ul>
                        @foreach (var unit in Projection.Units.Where(unit => unit.SeatId == seat.SeatId))
                        {
                            <li class="@RosterClass(unit)" data-roster-unit="@unit.UnitId" aria-current="@(unit.UnitId == _selectedUnitId ? "true" : null)">
                                <button type="button" class="roster-unit" data-focus-unit disabled="@(unit.Hex is null)"
                                        title="@(unit.Hex is null ? null : "Show on the battlefield")" @onclick="() => FocusUnit(unit)">
                                <span>
                                    @unit.Name
                                    @switch (ActivationState(unit))
                                    {
                                        case "activating":
                                            <span class="activation-tag activating">Acting</span>
                                            break;
                                        case "spent":
                                            <span class="activation-tag spent">Activated</span>
                                            break;
                                    }
                                </span>
                                <span class="roster-health" aria-label="@(RemainingHp(unit) + " HP")"><StatIcon Label="HP" />@RemainingHp(unit)</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>

        <div class="rail-log" role="tabpanel" id="rail-panel-log" aria-labelledby="rail-tab-log" hidden="@(railTab != LogTab)">
            <CombatLog Projection="Projection" Events="Events" />
        </div>
        <AttackPopup Projection="Projection" Events="Events" LiveAfterSequence="LiveAfterSequence" ImageBaseUrl="@ImageBaseUrl"
                     OnShowingChanged="showing => _attackShowing = showing" />
        <TurnPopup Projection="Projection" Held="_attackShowing" />
    </aside>

    @if (Projection.Result is { } result)
    {
        <section class="match-end" role="dialog" aria-modal="true" aria-labelledby="match-end-title" data-testid="match-end">
            <h2 id="match-end-title">@ResultTitle(result)</h2>
            <p>@ResultSummary(result)</p>
            @if (Projection.Viewer.CanCommand)
            {
                <button type="button" data-action="returnToWarRoom" @onclick="() => OnReturnToWarRoom.InvokeAsync()">Return to war room</button>
            }
        </section>
    }
</main>

@code {
    [Parameter, EditorRequired]
    public GameProjection Projection { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<GameEvent> Events { get; set; } = [];

    /// <summary>Attacks after this sequence arrived live and get the attack popup; null while history is still loading.</summary>
    [Parameter]
    public long? LiveAfterSequence { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? ImageBaseUrl { get; set; }

    [Parameter]
    public EventCallback<GameCommandRequest> OnCommand { get; set; }

    [Parameter]
    public EventCallback OnReturnToWarRoom { get; set; }

    [Parameter]
    public EventCallback OnBackToWarRoom { get; set; }

    /// <summary>The host begins the match from the Void Lord's war-room board.</summary>
    [Parameter]
    public EventCallback OnStart { get; set; }

    [Parameter]
    public EventCallback<bool> OnReadyChanged { get; set; }

    [Parameter]
    public string InviteBaseUri { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnFollowEvents { get; set; }

    private const double ZoomFactor = 1.2;
    private readonly BoardViewport _viewport = new();
    private readonly HashSet<long> _capturedPointers = [];
    private ElementReference _boardElement;
    private IJSObjectReference? _viewportModule;
    private ElementBounds _boardBounds = new();
    private bool _followEvents = true;
    private string? _lastActiveSeatId;

    private string? _selectedUnitId;
    private sealed record Targeting(string Kind, string Ability, IReadOnlyList<string> TargetHexes, TargetSelectionProjection? Selection);

    private Targeting? _targeting;
    private MovementOptionProjection? _previewedMovement;
    private MovementOptionProjection? _confirmingMovement;
    private string? _confirmingMovementAbility;
    private bool _swingChoice;
    private string? _lastGameId;
    private long _lastProjectionVersion = long.MinValue;

    private static IEnumerable<(string Stat, string Label, int Base, int Effective)> StatRows(UnitProjection unit) =>
    [
        ("move", "Move", unit.Move, unit.EffectiveMove ?? unit.Move),
        ("range", "Range", unit.Range, unit.EffectiveRange ?? unit.Range),
        ("power", "Power", unit.Power, unit.EffectivePower ?? unit.Power),
        ("defense", "Defense", unit.Defense, unit.EffectiveDefense ?? unit.Defense),
    ];

    private static string? EffectSources(UnitProjection unit, string stat)
    {
        var sources = unit.Effects
            .Where(effect => effect.Stat == stat)
            .Select(effect => $"{effect.Name} {(effect.Amount > 0 ? "+" : "")}{effect.Amount} {(effect.Expires == "endOfTurn" ? "until end of turn" : "until your next turn")}")
            .Concat(unit.Conditions
                .Where(condition => ConditionText.StatDelta(condition.Name, stat, condition.Data.PowerPenalty, condition.Data.Level) != 0)
                .Select(condition => $"{condition.Name} {ConditionText.StatDelta(condition.Name, stat, condition.Data.PowerPenalty, condition.Data.Level).ToString("+0;−0", System.Globalization.CultureInfo.InvariantCulture)} {ConditionText.Expiry(condition.Expires, condition.Name)}"))
            .ToList();
        return sources.Count == 0 ? null : string.Join("; ", sources);
    }

    private IReadOnlyList<LegalAction> AbilityActions(string unitId) => !Projection.Viewer.CanCommand ? [] : Projection.LegalActions
        .Where(action => action.UnitId == unitId && (action.Kind is "specialAttack" or "useAbility" or "moveAbility"))
        .ToList();

    private async Task StartTargeting(LegalAction action)
    {
        ClearMovementState();
        _swingChoice = false;
        _chain.Clear();
        _pickedTargets.Clear();
        _teleportUnitId = null;
        // Pan Pipes is an aura around the piper itself, so there is nothing to aim.
        if (action.Ability == "Pan Pipes")
        {
            _targeting = null;
            await Send("specialAttack", new { unitId = action.UnitId, ability = action.Ability, targetUnitIds = new[] { action.UnitId } });
            return;
        }
        _targeting = _targeting?.Ability == action.Ability ? null : new Targeting(action.Kind, action.Ability!, action.TargetHexes, action.TargetSelection);
    }
    private string? _hoveredUnitId;

    /// <summary>The unit last picked from the army list, marked on the board until the board is clicked.</summary>
    private string? _spotlitUnitId;

    protected override void OnParametersSet()
    {
        var newGame = _lastGameId != Projection.GameId;
        if (newGame)
        {
            _followEvents = true;
        }
        else if (!Projection.Viewer.CanCommand && Projection.Turn.ActiveSeatId != _lastActiveSeatId)
        {
            // Spectators pick the camera back up each turn; players keep the view they chose.
            _followEvents = true;
        }
        _lastActiveSeatId = Projection.Turn.ActiveSeatId;
        var layout = Index.Layout;
        _viewport.ResetForGame(
            Projection.GameId,
            new WorldRect(0, 0, layout.Width, layout.Height),
            _viewport.ContainerWidth,
            _viewport.ContainerHeight);
        if (_followEvents)
        {
            FrameEvents();
        }
        if (_lastGameId != Projection.GameId || _lastProjectionVersion != Projection.Version)
        {
            ClearMovementState();
            if (MultiSelecting)
            {
                CancelTargeting();
            }
            _swingChoice = false;
            _lastGameId = Projection.GameId;
            _lastProjectionVersion = Projection.Version;
        }
        if (_selectedUnitId is not null && !Inspectable(_selectedUnitId))
        {
            _selectedUnitId = null;
        }
        if (_selectedUnitId is null && Projection.Turn.ActiveUnitId is { } active && Selectable(active))
        {
            _selectedUnitId = active;
            ShowArmyTabOf(active);
        }
        if (_targeting is { } aiming && !AbilityActions(_selectedUnitId ?? string.Empty).Any(action => action.Ability == aiming.Ability))
        {
            CancelTargeting();
        }
        if (ErrorMessage != _lastError)
        {
            if (!string.IsNullOrEmpty(ErrorMessage))
            {
                CancelTargeting();
            }
            _lastError = ErrorMessage;
        }
    }

    private bool IsMyTurn => Projection.Viewer.SeatId is not null && Projection.Turn.ActiveSeatId == Projection.Viewer.SeatId;

    // Gold while the viewer holds the turn, red while anyone else does; no colour change in setup or once decided
    private string? RibbonState =>
        InSetup || Projection.Result is not null || Projection.Turn.ActiveSeatId is null ? null
        : IsMyTurn ? "my-turn" : "their-turn";

    private string? ActiveEmblem =>
        InSetup || Projection.Result is not null || Projection.Turn.ActiveSeatId is not { } active ? null
        : CatalogImages.Resolve(ImageBaseUrl, Projection.Armies?.GetValueOrDefault(active)?.Emblem);

    private UnitProjection? SelectedUnit => UnitById(_selectedUnitId);

    // The viewer's unit that is mid-activation; null between activations or on someone else's turn
    private UnitProjection? ActingUnit => IsMyTurn ? UnitById(Projection.Turn.ActiveUnitId) : null;

    private string ActivationsLeft => Projection.Turn.ActivationAllowance > 0
        ? $"{Projection.Turn.ActivationsRemaining}/{Projection.Turn.ActivationAllowance}"
        : $"{Projection.Turn.ActivationsRemaining}";

    private bool MustActivateHero => Projection.Mode == GameMode.VanillaPvp
        && Projection.Turn.ActivationsRemaining == 1
        && Projection.Units.Any(unit => unit.SeatId == Projection.Viewer.SeatId && unit.IsHero && unit.Hex is not null && !unit.ActivatedThisTurn)
        && Projection.Units.Count(unit => unit.SeatId == Projection.Viewer.SeatId && !unit.IsHero && unit.ActivatedThisTurn) >= 3;

    private string? SelectedHex => _selectedUnitId is null ? null : Index.OccupiedHex.GetValueOrDefault(_selectedUnitId);

    // Frames the latest event, keeping the acting unit and as many other units as fit in view
    private void FrameEvents() => _viewport.Frame(HexPoints(FocusHexes), ActingUnitPoints(), UnitPoints(), BoardLayout.Size);

    private List<ViewportPoint> ActingUnitPoints(string? except = null) =>
        Projection.Turn.ActiveUnitId is { } active && active != except && UnitById(active)?.Hex is { } hex ? HexPoints([hex]) : [];

    private List<ViewportPoint> UnitPoints() => HexPoints(Projection.Units.Select(unit => unit.Hex).OfType<string>());

    private List<ViewportPoint> HexPoints(IEnumerable<string> hexes) => hexes
        .Select(key => Index.TileByKey.GetValueOrDefault(key))
        .OfType<HexTile>()
        .Select(tile => new ViewportPoint(tile.X, tile.Y))
        .ToList();

    private IReadOnlyList<string> FocusHexes =>
        Events.Reverse().FirstOrDefault(gameEvent => gameEvent.FocusHexes.Count > 0)?.FocusHexes ?? [];

    private string? _selectedMonster;

    private bool InSetup => Projection.Setup is { Redacted: false }
        && (Projection.Lifecycle == GameLifecycle.Setup
            || (Projection.Mode == GameMode.Coop
                && Projection.Lifecycle is GameLifecycle.Lobby or GameLifecycle.Draft
                && SeatNames.IsVoidLord(Projection, Projection.Viewer.SeatId)));

    // Simultaneous Co-op prep: the banner carries the war room or draft progress instead of the setup title
    private string? SetupStatus
    {
        get
        {
            if (Projection.Lifecycle == GameLifecycle.Lobby)
            {
                var heroes = Projection.Memberships.Where(member => member.Role != "voidLord").ToList();
                return $"War room · {heroes.Count} {(heroes.Count == 1 ? "hero" : "heroes")}, {heroes.Count(member => member.Ready)} ready";
            }
            if (Projection.Lifecycle == GameLifecycle.Draft && Projection.Draft is { } draft)
            {
                var picks = $"{draft.PicksMade}/{draft.PicksTotal} picks";
                return Projection.Setup!.Confirmed ? $"Waiting for the heroes · {picks}"
                    : draft.PicksMade >= draft.PicksTotal ? $"The heroes are ready · {picks}"
                    : $"Heroes drafting · {picks}";
            }
            return null;
        }
    }

    private bool InWarRoomSetup => InSetup && Projection.Lifecycle == GameLifecycle.Lobby;

    private bool ShowBeginButton => InWarRoomSetup && Projection.Viewer.IsHost;

    private bool ShowUnleashButton => InSetup && Projection.Lifecycle != GameLifecycle.Lobby
        && !Projection.Setup!.Confirmed && SeatNames.IsVoidLord(Projection, Projection.Viewer.SeatId);

    private string? StartNote => !InWarRoomSetup ? null
        : !Projection.Viewer.IsHost ? "Waiting for the host to begin the incursion."
        : LobbyRules.StartBlocker(Projection);

    private IReadOnlyList<string> PlaceableHexes => !InSetup || _selectedMonster is null
        ? []
        : Projection.LegalActions.Where(action => action.Kind == "placeMonster" && (action.Monster is null || action.Monster == _selectedMonster))
            .SelectMany(action => action.TargetHexes).ToList();

    private void SelectMonster(string name) => _selectedMonster = _selectedMonster == name ? null : name;

    private string TurnStatus
    {
        get
        {
            if (InSetup)
            {
                return SetupStatus ?? "Setup · The Void Lord summons the horde";
            }
            var round = $"Round {Projection.Turn.Round}";
            if (Projection.Result is not null)
            {
                return $"{round} · The battle is decided";
            }
            if (Projection.Turn.ActiveSeatId is null)
            {
                return round;
            }
            if (IsMyTurn)
            {
                return $"{round} · Your turn · {Projection.Turn.ActivationsRemaining} {(Projection.Turn.ActivationsRemaining == 1 ? "activation" : "activations")}";
            }
            if (IsCoop)
            {
                var actor = SeatNames.Display(Projection, Projection.Turn.ActiveSeatId);
                return Projection.Turn.RespondingToSeatId is { } answering
                    ? $"{round} · {actor}'s turn — answering {SeatNames.Display(Projection, answering)}"
                    : $"{round} · {actor}'s turn";
            }
            var opponent = Projection.Memberships.FirstOrDefault(member => member.SeatId == Projection.Turn.ActiveSeatId)?.Name;
            return Projection.Viewer.CanCommand
                ? $"{round} · {(string.IsNullOrEmpty(opponent) ? "Opponent" : opponent)}'s turn"
                : $"{round} · {SeatName(Projection.Turn.ActiveSeatId)}'s turn";
        }
    }

    private bool Selectable(string unitId) =>
        Projection.Viewer.CanCommand &&
        (Projection.LegalActions.Any(action => action.UnitId == unitId && (action.Kind is "moveUnit" or "moveAbility" or "attackUnit" or "specialAttack" or "useAbility"))
         || Projection.Units.Any(unit => unit.UnitId == unitId && unit.SeatId == Projection.Viewer.SeatId && unit.Hex is not null
             && unit.Conditions.Any(condition => condition.Name is "Petrified" or "Entrapped" or "Pan Pipes" or "Charmed")));

    private bool Inspectable(string unitId) => UnitById(unitId)?.Hex is not null || Selectable(unitId);

    private IReadOnlyList<string> Targets(string kind) => !Projection.Viewer.CanCommand || _selectedUnitId is null
        ? []
        : Projection.LegalActions
            .Where(action => action.Kind == kind && action.UnitId == _selectedUnitId)
            .SelectMany(action => action.TargetHexes)
            .ToList();

    private async Task SelectHex(HexProjection hex, bool keyboardActivation = false)
    {
        if (!keyboardActivation && _viewport.ConsumeSuppressedActivation())
        {
            return;
        }
        _spotlitUnitId = null;
        if (IsBusy)
        {
            return;
        }
        var key = HexKey(hex);
        if (InSetup)
        {
            if (!Projection.Viewer.CanCommand)
            {
                return;
            }
            var removal = Projection.LegalActions.FirstOrDefault(action => action.Kind == "removeMonster" && action.TargetHexes.Contains(key));
            if (removal is not null)
            {
                await Send("removeMonster", new { unitId = removal.UnitId });
            }
            else if (_selectedMonster is { } monster && PlaceableHexes.Contains(key))
            {
                await Send("placeMonster", new { monster, hex = key });
            }
            return;
        }
        if (Projection.PendingChoice is { Kind: "panPipes" or "skyToss" } control)
        {
            if (control.SeatId == Projection.Viewer.SeatId && control.TargetHexes.Contains(key))
            {
                var option = control.Kind == "panPipes" ? $"target:{hex.OccupantId}" : $"land:{key}";
                if (control.Options.Contains(option))
                {
                    await Resolve(control.ChoiceId, option);
                }
            }
            return;
        }
        if (Projection.PendingChoice is { Kind: "iceCollision" } ice)
        {
            if (_swingChoice && ice.TargetHexes.Contains(key) && ice.Options.Contains($"swing:{key}"))
            {
                await ResolveIce(ice, $"swing:{key}");
            }
            return;
        }
        if (Projection.PendingChoice is not null)
        {
            return;
        }
        if (_targeting is { } aiming && _selectedUnitId is { } caster)
        {
            var aimed = key;
            if (MultiSelecting)
            {
                if (SelectionCandidates().Contains(aimed) && hex.OccupantId is { } picked)
                {
                    _pickedTargets.Add(picked);
                }
                return;
            }
            if (aiming.Ability == "Tentacle Regeneration")
            {
                if (aiming.TargetHexes.Contains(aimed) && hex.OccupantId is null)
                {
                    CancelTargeting();
                    await Send("specialAttack", new { unitId = caster, ability = aiming.Ability, targetUnitIds = new[] { caster }, toHex = aimed });
                }
                return;
            }
            if (aiming.Kind == "moveAbility")
            {
                if (aiming.TargetHexes.Contains(aimed) && MovementOption(aimed) is { } movement)
                {
                    _previewedMovement = movement;
                    if (RequiresConfirmation(movement))
                    {
                        _confirmingMovement = movement;
                        _confirmingMovementAbility = aiming.Ability;
                        return;
                    }
                    CancelTargeting();
                    await Send("moveAbility", new { unitId = caster, ability = aiming.Ability, toHex = aimed });
                }
                return;
            }
            if (Teleporting)
            {
                if (_teleportUnitId is { } traveller && TeleportDestinations(traveller).Contains(aimed))
                {
                    CancelTargeting();
                    await Send("specialAttack", new { unitId = caster, ability = "Teleport", targetUnitIds = new[] { traveller }, toHex = aimed });
                }
                else if (aiming.TargetHexes.Contains(aimed) && hex.OccupantId is { } candidate)
                {
                    _teleportUnitId = candidate;
                }
                return;
            }
            if (Chaining)
            {
                if (ChainCandidates().Contains(aimed) && hex.OccupantId is { } link)
                {
                    _chain.Add(link);
                }
                return;
            }
            if (aiming.TargetHexes.Contains(aimed) && hex.OccupantId is { } targetId)
            {
                CancelTargeting();
                if (aiming.Kind == "specialAttack")
                {
                    await Send("specialAttack", new { unitId = caster, ability = aiming.Ability, targetUnitIds = new[] { targetId } });
                }
                else
                {
                    await Send("useAbility", new { unitId = caster, ability = aiming.Ability, targetUnitId = targetId });
                }
            }
            return;
        }
        if (_selectedUnitId is { } unitId)
        {
            if (Targets("moveUnit").Contains(key))
            {
                if (MovementOption(key) is { } movement)
                {
                    _previewedMovement = movement;
                    if (RequiresConfirmation(movement))
                    {
                        _confirmingMovement = movement;
                        return;
                    }
                    await Send("moveUnit", new { unitId, path = movement.Path });
                    return;
                }
                await Send("moveUnit", new { unitId, to = key });
                return;
            }
            if (Targets("attackUnit").Contains(key) && hex.OccupantId is { } targetUnitId)
            {
                await Send("attackUnit", new { unitId, targetUnitId });
                return;
            }
        }
        var selected = hex.OccupantId is { } occupant && Inspectable(occupant) ? occupant : null;
        if (_selectedUnitId != selected)
        {
            ClearMovementState();
        }
        _selectedUnitId = selected;
        ShowArmyTabOf(hex.OccupantId);
    }

    private const int ChainReach = 5;
    private const int ChainMaxTargets = 3;
    private readonly List<string> _chain = [];

    private const int TeleportReach = 3;
    private string? _teleportUnitId;

    private bool Teleporting => _targeting?.Ability == "Teleport";

    /// <summary>Same rule as the server's Forced::teleportDestinations.</summary>
    private IReadOnlyList<string> TeleportDestinations(string unitId)
    {
        var origin = UnitById(unitId)?.Hex;
        var start = origin is null ? null : Index.HexByKey.GetValueOrDefault(origin);
        if (origin is null || start is null)
        {
            return [];
        }
        return Projection.Board.Hexes
            .Where(hex => !hex.SightBlocker && hex.OccupantId is null && HexKey(hex) != origin)
            .Where(hex => HexMath.Distance(origin, HexKey(hex)) + Math.Abs(hex.Elevation - start.Elevation) / 2 <= TeleportReach)
            .Select(HexKey)
            .ToList();
    }

    private IReadOnlyList<string> PushPreview
    {
        get
        {
            var distance = _targeting?.Ability switch { "Tail Slash" or "Boulder Throw" => 1, "Stone Swat" or "Gust of Wind" => 2, _ => 0 };
            if (distance == 0 || _hoveredHex is not { } hovered || !_targeting!.TargetHexes.Contains(hovered)
                || SelectedHex is not { } casterHex || HexMath.DirectionAway(casterHex, hovered) is not { } direction)
            {
                return [];
            }
            var path = new List<string>();
            var current = Index.HexByKey[hovered];
            for (var step = 0; step < distance; step++)
            {
                var nextKey = HexMath.Step(HexKey(current), direction);
                var next = Index.HexByKey.GetValueOrDefault(nextKey);
                if (next is null || next.SightBlocker || next.OccupantId is not null || next.Elevation - current.Elevation >= 2)
                {
                    break;
                }
                path.Add(nextKey);
                current = next;
            }
            return path;
        }
    }

    private string BannerText(Targeting aiming) => Teleporting
        ? (_teleportUnitId is null ? "Teleport: choose a unit" : "Teleport: choose where")
        : aiming.Selection is not null ? MultiSelectionText(aiming)
        : aiming.Ability == "Tail Slash" ? "Tail Slash: choose an adjacent enemy; save 11+ or be pushed 1 hex"
        : aiming.Ability == "Petrifying Gaze" ? "Petrifying Gaze: choose an enemy within 3 hexes; save 13+ or lose movement, attacks and Defense until your next turn"
        : aiming.Ability == "Stone Grip" ? "Stone Grip: choose an adjacent enemy; save 12+ or face Power 2 and become Entrapped through its next turn"
        : aiming.Ability == "Siren's Song" ? "Siren's Song: choose an enemy within 5 hexes; save 15+ or be charmed: on its next turn it must first walk as close as it can to the Mermaid and cannot attack"
        : aiming.Ability == "Sky Toss" ? "Sky Toss: choose an adjacent enemy; save 15+ or choose its landing within 4 hexes, with 3 undefended fall dice"
        : aiming.Ability == "Dragon Breath" ? "Dragon Breath: Power 6, Range 4; adjacent units, including allies, defend against one fewer sword"
        : aiming.Ability == "Column Swing" ? "Column Swing: choose an enemy within 2 hexes; Power 5"
        : aiming.Ability == "Column Toss" ? "Column Toss: choose an enemy 3–4 hexes away; Power 7. Tossing permanently spends the column and disables both column attacks"
        : aiming.Ability == "Boulder Throw" ? "Boulder Throw: choose an enemy within 3 hexes; a surviving target is pushed 1 hex"
        : aiming.Ability == "Stone Swat" ? "Stone Swat: choose an adjacent enemy; a surviving target is pushed 2 hexes"
        : aiming.Kind == "moveAbility" ? $"{aiming.Ability}: choose a destination"
        : aiming.Ability == "Tentacle Regeneration" ? "Tentacle Regeneration: choose adjacent water for a new tentacle; it can act next Void turn"
        : aiming.Ability == "Spore Bomb" ? "Spore Bomb: click the caster to release spores within 2 hexes and defeat itself"
        : aiming.Ability == "Spore Cloud" ? "Spore Cloud: click the caster to release spores within 3 hexes"
        : $"{aiming.Ability}: choose a target";

    private bool Chaining => _targeting?.Ability == "Chain Lightning";

    private readonly List<string> _pickedTargets = [];
    private bool MultiSelecting => _targeting?.Selection is not null;
    private int PickedIndex(string unitId) => MultiSelecting ? _pickedTargets.IndexOf(unitId) : _chain.IndexOf(unitId);

    private string MultiSelectionText(Targeting aiming) => aiming.Selection?.Mode == "independent"
        ? $"{aiming.Ability}: choose up to 3 enemies · Power {6 - Math.Max(1, _pickedTargets.Count)}{(_pickedTargets.Count > 1 ? " each" : "")}"
        : _pickedTargets.Count == 0 ? $"{aiming.Ability}: choose a primary target"
        : $"{aiming.Ability}: choose up to 2 adjacent enemies, or strike now";

    private IReadOnlyList<string> SelectionCandidates()
    {
        if (_targeting is not { Selection: { } selection } aiming || _pickedTargets.Count >= selection.MaxTargets)
        {
            return [];
        }
        IReadOnlyList<string> candidates = aiming.TargetHexes;
        if (selection.Mode == "adjacentEnemies" && _pickedTargets.Count > 0)
        {
            var primaryHex = UnitById(_pickedTargets[0])?.Hex;
            candidates = primaryHex is not null && selection.SecondaryTargets.TryGetValue(primaryHex, out var secondary) ? secondary : [];
        }
        return candidates.Where(hex => Index.HexByKey.GetValueOrDefault(hex)?.OccupantId is { } id && !_pickedTargets.Contains(id)).ToList();
    }

    private void UndoTarget()
    {
        if (_pickedTargets.Count > 0)
        {
            _pickedTargets.RemoveAt(_pickedTargets.Count - 1);
        }
    }

    private async Task ConfirmTargets()
    {
        if (_selectedUnitId is { } caster && _targeting is { } aiming && _pickedTargets.Count > 0)
        {
            var targets = _pickedTargets.ToArray();
            CancelTargeting();
            await Send("specialAttack", new { unitId = caster, ability = aiming.Ability, targetUnitIds = targets });
        }
    }

    /// <summary>Hexes the next Chain Lightning link may hit: first hop from the server's list, later hops by remaining reach.</summary>
    private IReadOnlyList<string> ChainCandidates()
    {
        if (_targeting is null || _selectedUnitId is null || _chain.Count >= ChainMaxTargets)
        {
            return [];
        }
        if (_chain.Count == 0)
        {
            return _targeting.TargetHexes;
        }
        var caster = UnitById(_selectedUnitId)!;
        var path = new[] { caster.Hex! }.Concat(_chain.Select(id => UnitById(id)!.Hex!)).ToList();
        var spent = path.Zip(path.Skip(1), HexMath.Distance).Sum();
        var last = path[^1];
        return Projection.Units
            .Where(unit => unit.Hex is not null && SideOf(unit) != SideOf(caster) && !_chain.Contains(unit.UnitId))
            .Where(unit => spent + HexMath.Distance(last, unit.Hex!) <= ChainReach)
            .Select(unit => unit.Hex!)
            .ToList();
    }

    private async Task StrikeChain()
    {
        if (_selectedUnitId is { } caster && _chain.Count > 0)
        {
            var targets = _chain.ToArray();
            _chain.Clear();
            _targeting = null;
            await Send("specialAttack", new { unitId = caster, ability = "Chain Lightning", targetUnitIds = targets });
        }
    }

