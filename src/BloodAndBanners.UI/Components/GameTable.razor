    /// <summary>
    /// Hex sets for the current selection, aim and preview, built once per render so each hex on the
    /// board is a constant-time lookup rather than a fresh scan of the legal actions and the board.
    /// </summary>
    private BoardView BuildView()
    {
        var preview = PreviewedMovement;
        var pathSteps = new Dictionary<string, int>();
        var hazards = new Dictionary<string, MovementHazardProjection>();
        if (preview is not null)
        {
            for (var step = 0; step < preview.Path.Count; step++)
            {
                pathSteps.TryAdd(preview.Path[step], step + 1);
            }
            foreach (var hazard in preview.Hazards)
            {
                hazards.TryAdd(hazard.Hex, hazard);
            }
        }
        IReadOnlyList<string> aimed = _targeting is null ? [] : MultiSelecting ? SelectionCandidates() : Chaining ? ChainCandidates() : _targeting.TargetHexes;
        return new BoardView(
            SelectedHex,
            _spotlitUnitId is null ? null : Index.OccupiedHex.GetValueOrDefault(_spotlitUnitId),
            Targets("moveUnit").ToHashSet(),
            Targets("attackUnit").ToHashSet(),
            FocusHexes.ToHashSet(),
            PlaceableHexes.ToHashSet(),
            InSetup ? Projection.Setup!.SpawnZoneHexes.ToHashSet() : [],
            aimed.ToHashSet(),
            Teleporting && _teleportUnitId is { } traveller ? TeleportDestinations(traveller).ToHashSet() : [],
            PushPreview.ToHashSet(),
            SplashHexes.ToHashSet(),
            pathSteps,
            hazards);
    }

    private sealed class BoardTile(GameTable owner, HexTile tile)
    {
        public HexTile Tile { get; } = tile;
        public string Key { get; } = HexKey(tile.Hex);
        public string PatternId { get; } = TerrainPatternId(tile.Hex);
        public string TerrainClass { get; } = GameTable.TerrainClass(tile.Hex);
        public string? Label { get; set; }
        public Func<Task> Select { get; } = () => owner.SelectHex(tile.Hex);
        public Func<PointerEventArgs, Task> PointerDown { get; } = args => owner.BeginBoardPointer(args, false);
        public Func<KeyboardEventArgs, Task> KeyDown { get; } = args => owner.OnHexKey(args, tile.Hex);
        public Action Hover { get; } = () => owner.Hover(tile.Hex);
    }

    private sealed class BoardIndex
    {
        public required BoardLayout Layout { get; init; }
        public required IReadOnlyList<BoardTile> Tiles { get; init; }
        public required IReadOnlyList<(string Id, HexProjection Hex)> TerrainPatterns { get; init; }
        public required Dictionary<string, HexTile> TileByKey { get; init; }
        public required Dictionary<string, HexProjection> HexByKey { get; init; }
        public required Dictionary<string, string> OccupiedHex { get; init; }
        public required Dictionary<string, UnitProjection> UnitById { get; init; }
        public required Dictionary<string, MovementHazardProjection> ProjectedHazards { get; init; }

        public static BoardIndex For(GameTable owner)
        {
            var projection = owner.Projection;
            var layout = BoardLayout.For(projection.Board.Hexes);
            var tiles = layout.Tiles
                .Select(tile => new BoardTile(owner, tile))
                .ToList();
            var tileByKey = new Dictionary<string, HexTile>();
            foreach (var tile in tiles)
            {
                tileByKey.TryAdd(tile.Key, tile.Tile);
            }
            // Board order rather than paint order, so the first match agrees with a scan of the projection
            var hexByKey = new Dictionary<string, HexProjection>();
            var occupiedHex = new Dictionary<string, string>();
            foreach (var hex in projection.Board.Hexes)
            {
                var key = HexKey(hex);
                hexByKey.TryAdd(key, hex);
                if (hex.OccupantId is { } occupant)
                {
                    occupiedHex.TryAdd(occupant, key);
                }
            }
            var unitById = new Dictionary<string, UnitProjection>();
            foreach (var unit in projection.Units)
            {
                unitById.TryAdd(unit.UnitId, unit);
            }
            var projectedHazards = new Dictionary<string, MovementHazardProjection>();
            foreach (var hazard in projection.LegalActions.SelectMany(action => action.MovementOptions).SelectMany(option => option.Hazards))
            {
                projectedHazards.TryAdd(hazard.Hex, hazard);
            }
            return new BoardIndex
            {
                Layout = layout,
                Tiles = tiles,
                TerrainPatterns = tiles.DistinctBy(tile => tile.PatternId).Select(tile => (tile.PatternId, tile.Tile.Hex)).ToList(),
                TileByKey = tileByKey,
                HexByKey = hexByKey,
                OccupiedHex = occupiedHex,
                UnitById = unitById,
                ProjectedHazards = projectedHazards,
            };
        }
    }

    private sealed record BoardView(
        string? SelectedHex,
        string? SpotlitHex,
        HashSet<string> Moves,
        HashSet<string> Attacks,
        HashSet<string> Focus,
        HashSet<string> Placeable,
        HashSet<string> Spawn,
        HashSet<string> Aimed,
        HashSet<string> Destinations,
        HashSet<string> Push,
        HashSet<string> Splash,
        Dictionary<string, int> PathSteps,
        Dictionary<string, MovementHazardProjection> Hazards)
    {
        public static readonly BoardView Empty = new(null, null, [], [], [], [], [], [], [], [], [], [], []);
    }

