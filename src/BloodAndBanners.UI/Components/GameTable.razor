    private string? HexState(string key)
    {
        var classes = new List<string>();
        if (InteractionHexState(key) is { } interaction)
        {
            classes.Add(interaction);
        }
        if (_view.PathSteps.ContainsKey(key))
        {
            classes.Add("movement-path");
        }
        if (HazardAt(key)?.Forced == true)
        {
            classes.Add("forced-slide");
        }
        if (_view.Spawn.Contains(key))
        {
            classes.Add("spawn-zone");
        }
        if (_view.Placeable.Contains(key))
        {
            classes.Add("placeable");
        }
        if (key == _view.SpotlitHex)
        {
            classes.Add("spotlit");
        }
        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private string? InteractionHexState(string key)
    {
        if (Projection.PendingChoice is { Kind: "panPipes" or "skyToss" } control
            && control.SeatId == Projection.Viewer.SeatId && control.TargetHexes.Contains(key))
        {
            return "control-target";
        }
        if (_swingChoice && Projection.PendingChoice?.TargetHexes.Contains(key) == true)
        {
            return "swing-target";
        }
        if (key == _view.SelectedHex)
        {
            return _view.Splash.Contains(key) ? "selected splash" : "selected";
        }
        if (_targeting is not null)
        {
            if (Teleporting && _teleportUnitId is not null)
            {
                return _view.Destinations.Contains(key) ? "destination" : null;
            }
            // Units already picked leave the candidate list, so they get their own, stronger mark
            var picked = Index.HexByKey.GetValueOrDefault(key)?.OccupantId is { } occupant && PickedIndex(occupant) >= 0;
            var state = picked ? "picked-target" : _view.Aimed.Contains(key) ? (TargetsAlly(key) ? "ally-target" : "ability-target") : null;
            if (_view.Push.Contains(key))
            {
                return $"{state} push-path".Trim();
            }
            return _view.Splash.Contains(key) ? $"{state} splash".Trim() : state;
        }
        if (_view.Attacks.Contains(key))
        {
            return "attackable";
        }
        if (_view.Moves.Contains(key))
        {
            return "reachable";
        }
        return _view.Focus.Contains(key) ? "focus" : null;
    }

    private MovementOptionProjection? PreviewedMovement => _confirmingMovement ?? _previewedMovement;

    private MovementOptionProjection? MovementOption(string destination) => _selectedUnitId is null
        ? null
        : Projection.LegalActions
            .Where(action => action.UnitId == _selectedUnitId && (_targeting is { Kind: "moveAbility" } aiming
                ? action.Kind == "moveAbility" && action.Ability == aiming.Ability
                : action.Kind == "moveUnit"))
            .SelectMany(action => action.MovementOptions)
            .FirstOrDefault(option => option.Destination == destination);

    private int? PathStep(string key) => _view.PathSteps.TryGetValue(key, out var step) ? step : null;

    private MovementHazardProjection? HazardAt(string key) => _view.Hazards.GetValueOrDefault(key);

    private MovementHazardProjection? ProjectedHazardAt(string key) => Index.ProjectedHazards.GetValueOrDefault(key);

    private static bool RequiresConfirmation(MovementOptionProjection movement) =>
        movement.Hazards.Any(hazard => hazard.Dice > 0 || hazard.Forced || hazard.Stops || hazard.Kind == "condition");

    private static string MovementRisk(MovementOptionProjection movement)
    {
        var risks = new List<string>();
        var dice = movement.Hazards.Sum(hazard => hazard.Dice);
        if (dice > 0)
        {
            risks.Add($"{dice} damage {(dice == 1 ? "die" : "dice")}, no Defense roll");
        }
        if (movement.Hazards.Any(hazard => hazard.Forced))
        {
            risks.Add("includes forced ice movement");
        }
        if (movement.Hazards.Any(hazard => hazard.Stops))
        {
            risks.Add("movement stops on entry");
        }
        if (movement.Hazards.Any(hazard => hazard.Kind == "condition" && hazard.Terrain == "poison"))
        {
            risks.Add("becomes Poisoned");
        }
        if (movement.Hazards.Any(hazard => hazard.Kind == "condition" && hazard.Terrain == "ice"))
        {
            risks.Add("becomes Unsteady");
        }
        return risks.Count == 0 ? "No projected terrain hazards." : string.Join(" · ", risks);
    }

    private async Task ConfirmMovement()
    {
        if (_selectedUnitId is not { } unitId || _confirmingMovement is not { } movement)
        {
            return;
