@namespace BloodAndBanners.UI.Components
@using System.Net
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IGameSessionCoordinator Sessions
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider

@if (_game is null)
{
    <QuickStart ClientKind="@ClientKind"
                ImageBaseUrl="@ImageBaseUrl"
                StatusMessage="@_status"
                OnResume="ResumeGame"
                IsBusy="_isBusy"
                ErrorMessage="@_error"
                InitialJoinCode="@InitialJoinCode"
                LoadBoard="LoadScenarioBoard"
                LoadOwnMaps="LoadOwnMaps"
                LoadOwnBoard="LoadOwnBoard"
                OnCreate="CreateGame"
                OnJoin="JoinGame"
                OnWatch="WatchGame"
                WatchOfferGameId="@_watchOffer" />
}
else if (_game.Lifecycle == GameLifecycle.Lobby && IsWatching)
{
    <SpectatorWaiting Projection="_game" OnLeave="ReturnToWarRoom" />
}
else if (_game.Lifecycle == GameLifecycle.Lobby && _placingMonsters && VoidLordPreparing)
{
    <GameTable Projection="_game"
               PlayEntrance="_playEntrance"
               Events="_events"
               LiveAfterSequence="_liveAfterSequence"
               IsBusy="_isBusy"
               ErrorMessage="@_error"
               ImageBaseUrl="@ImageBaseUrl"
               InviteBaseUri="@InviteBaseUri"
               OnCommand="SubmitGameCommand"
               OnReturnToWarRoom="LeaveWarRoom"
               OnBackToWarRoom="() => _placingMonsters = false"
               OnStart="StartGame"
               OnReadyChanged="SetReady" />
}
else if (_game.Lifecycle == GameLifecycle.Lobby)
{
    <WarRoomLobby OnPlaceMonsters="() => _placingMonsters = true"
                   Projection="_game"
                  InviteUrl="@InviteUrl"
                  IsBusy="_isBusy"
                  StatusMessage="@_status"
                  ErrorMessage="@_error"
                  OnReadyChanged="SetReady"
                  OnStart="StartGame"
                  OnCommand="SubmitGameCommand"
                  OnCopyInvite="CopyInvite"
                  OnRemoveSeat="RemoveSeat"
                  OnWatchInstead="WatchInstead"
                  OnLeave="LeaveWarRoom" />
}
else if (_game.Lifecycle == GameLifecycle.Draft && _game.Draft is not null && !VoidLordPreparing)
{
    <DraftTable Projection="_game"
                Events="_events"
                IsBusy="_isBusy"
                ErrorMessage="@_error"
                ImageBaseUrl="@ImageBaseUrl"
                InviteBaseUri="@InviteBaseUri"
                OnCommand="SubmitGameCommand"
                OnReturnToWarRoom="ReturnToWarRoom" />
}
else
{
    <GameTable Projection="_game"
               PlayEntrance="_playEntrance"
               Events="_events"
               LiveAfterSequence="_liveAfterSequence"
               IsBusy="_isBusy"
               ErrorMessage="@_error"
               ImageBaseUrl="@ImageBaseUrl"
               InviteBaseUri="@InviteBaseUri"
               OnCommand="SubmitGameCommand"
               OnReturnToWarRoom="ReturnToWarRoom" />
}

@code {
    [Parameter]
    public string ClientKind { get; set; } = "client";

    [Parameter]
    public string? InitialJoinCode { get; set; }

    [Parameter]
    public string InviteBaseUri { get; set; } = string.Empty;

    [Parameter]
    public string? ImageBaseUrl { get; set; }

    /// <summary>A game id from a watch link; when set, the page watches it instead of restoring a saved seat.</summary>
    [Parameter]
    public string? InitialWatchCode { get; set; }

    /// <summary>Raised after a spectator stops watching, so the host page can drop the watch link from its address.</summary>
    [Parameter]
    public EventCallback OnStoppedWatching { get; set; }

    /// <summary>A token from an emailed sign-in link; verified once on load.</summary>
    [Parameter]
    public string? InitialSignInToken { get; set; }

    /// <summary>Raised after the sign-in link was used, so the host page can drop it from its address.</summary>
    [Parameter]
    public EventCallback OnSignInLinkHandled { get; set; }

    private IAccountSession? Account => ServiceProvider.GetService(typeof(IAccountSession)) as IAccountSession;

    private Task ResumeGame(string gameId) => RunCommand(async () =>
    {
        _generation++;
        _watchOffer = null;
        try
        {
            ApplyProjection(await Sessions.ResumeAccountGameAsync(gameId, _pollCancellation.Token));
        }
        catch (GameApiException error) when (error.StatusCode == HttpStatusCode.NotFound)
        {
            _error = "You no longer hold a seat in that game.";
            return;
        }
        _status = null;
        StartPolling();
    }, "That game could not be resumed. Check your connection and try again.");

    private readonly CancellationTokenSource _pollCancellation = new();
    private GameProjection? _game;
    private bool _playEntrance;
    private readonly List<GameEvent> _events = [];
    private long _lastSequence;
    /// <summary>The last event of the first page fetched for this game; everything up to it is history, not news.</summary>
    private long? _liveAfterSequence;
    private int _generation;
    private Task? _pollTask;
    private bool _isBusy;
    private string? _status;
    private string? _error;
    private string? _watchOffer;
    private const string WatchFailed = "That match could not be found. Check the game code and try again.";

    private bool IsWatching => _game?.Viewer.Role == "spectator";

    private string InviteUrl => _game is null
        ? string.Empty
        : InviteLinks.Create(InviteBaseUri, _game.GameId);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialSignInToken) && Account is { } account)
        {
            try
            {
                var signedIn = await account.VerifyLinkAsync(InitialSignInToken!, DeviceId(), _pollCancellation.Token);
                _status = string.IsNullOrEmpty(signedIn.DisplayName)
                    ? "You are signed in. Choose your name above."
                    : $"Signed in as {signedIn.DisplayName}.";
            }
            catch (Exception) when (!_pollCancellation.IsCancellationRequested)
            {
                _error = "That sign-in link has expired or was already used. Request a new code.";
            }
            await OnSignInLinkHandled.InvokeAsync();
        }

        _isBusy = true;
        var watching = !string.IsNullOrWhiteSpace(InitialWatchCode);
        try
        {
            _game = watching
                ? await Sessions.WatchAsync(InitialWatchCode!, _pollCancellation.Token)
                : await Sessions.ReconnectAsync(_pollCancellation.Token);
            StartPolling();
        }
        catch (OperationCanceledException) when (_pollCancellation.IsCancellationRequested)
        {
        }
        catch (Exception) when (watching)
        {
            _error = WatchFailed;
            await OnStoppedWatching.InvokeAsync();
            await RestoreSavedSeat();
        }
        catch (Exception)
        {
            _error = "Your saved war room could not be restored. Check the server and try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>After watching ends, a player who holds a seat elsewhere goes back to their own match.</summary>
    private async Task RestoreSavedSeat()
    {
        try
        {
            if (await Sessions.ReconnectAsync(_pollCancellation.Token) is { } mine)
            {
                ApplyProjection(mine);
                StartPolling();
            }
        }
        catch (Exception) when (!_pollCancellation.IsCancellationRequested)
        {
            // No saved seat could be reached; the start screen stays.
        }
    }

    private Task<BoardProjection> LoadScenarioBoard(string scenarioName) =>
        Sessions.GetScenarioBoardAsync(scenarioName, _pollCancellation.Token);

    private IMapApiClient? Maps => ServiceProvider.GetService(typeof(IMapApiClient)) as IMapApiClient;

    /// <summary>The signed-in player's maps ready for the mode; none for guests.</summary>
    private async Task<IReadOnlyList<PlayableMap>> LoadOwnMaps(GameMode mode)
    {
        if (Account is not { } account || Maps is not { } maps || await account.LoadAsync() is null)
        {
            return [];
        }
        return (await account.CallAsync(session => maps.ListPlayableAsync(session, mode, _pollCancellation.Token), _pollCancellation.Token)).Maps;
    }

    private Task<BoardProjection> LoadOwnBoard(string revisionId) => Account is { } account && Maps is { } maps
        ? account.CallAsync(session => maps.LoadRevisionBoardAsync(session, revisionId, _pollCancellation.Token), _pollCancellation.Token)
        : Task.FromException<BoardProjection>(new InvalidOperationException("Sign in to preview your maps."));

    private Task CreateGame(GameSetupSelection selection) => RunCommand(async () =>
    {
        _generation++;
        _watchOffer = null;
        ApplyProjection(await Sessions.CreateGuestGameAsync(
            DeviceId(),
            selection.Mode,
            selection.ScenarioName,
            selection.ScenarioRevisionId,
            _pollCancellation.Token));
        _status = "War room opened. Share the invite link with your rival.";
        StartPolling();
    }, "The war room could not be reached. Check the server and try again.");

    private Task JoinGame(string gameId) => RunCommand(async () =>
    {
        _generation++;
        _watchOffer = null;
        try
        {
            ApplyProjection(await Sessions.JoinGuestGameAsync(
                DeviceId(),
                gameId,
                _pollCancellation.Token));
        }
        catch (GameApiException error) when (error.Code is "gameFull" or "gameAlreadyStarted")
        {
            _watchOffer = gameId.Trim();
            _error = "That match is full or already under way.";
            return;
        }
        _status = "You joined the war room.";
        StartPolling();
    }, "That war room could not be joined. Check the game code and try again.");

    private Task WatchGame(string gameId) => RunCommand(async () =>
    {
        _generation++;
        _watchOffer = null;
        ApplyProjection(await Sessions.WatchAsync(gameId, _pollCancellation.Token));
        _status = null;
        StartPolling();
    }, WatchFailed);

    private Task SetReady(bool ready)
    {
        if (_game is null)
        {
            return Task.CompletedTask;
        }

        var expectedVersion = _game.Version;
        return RunCommand(async () =>
        {
            ApplyProjection(await Sessions.SetReadyAsync(expectedVersion, ready, _pollCancellation.Token));
            _status = ready ? "Your banner is ready." : "Your banner is standing down.";
        }, "Readiness could not be changed. The room has been refreshed; try again.", refreshAfterFailure: true);
    }

    private Task StartGame() => RunCommand(async () =>
    {
        ApplyProjection(await Sessions.StartGameAsync(_pollCancellation.Token));
        _status = null;
    }, "The draft could not begin. The room has been refreshed; check that everyone is ready.", refreshAfterFailure: true);

    private async Task SubmitGameCommand(GameCommandRequest request)
    {
        if (_game is null)
        {
            return;
        }

        var expectedVersion = _game.Version;
        var generation = _generation;
        _isBusy = true;
        _error = null;
        try
        {
            if (_liveAfterSequence is null)
            {
                // Load history first, so this order's own attack is news rather than backlog.
                try
                {
                    ApplyEvents(await Sessions.GetEventsAsync(_lastSequence, _pollCancellation.Token));
                }
                catch (Exception) when (!_pollCancellation.IsCancellationRequested)
                {
                }
            }
            var updated = await Sessions.SubmitCommandAsync(expectedVersion, request.Kind, request.Payload, _pollCancellation.Token);
            if (generation != _generation)
            {
                return;
            }
            ApplyProjection(updated);
            try
            {
                var page = await Sessions.GetEventsAsync(_lastSequence, _pollCancellation.Token);
                if (generation == _generation)
                {
                    ApplyEvents(page);
                }
            }
            catch (Exception) when (!_pollCancellation.IsCancellationRequested)
            {
                // The log catches up on the next poll.
            }
        }
        catch (OperationCanceledException) when (_pollCancellation.IsCancellationRequested)
        {
        }
        catch (GameApiException error) when (error.StatusCode == HttpStatusCode.Conflict)
        {
            _error = "The battlefield changed — try again.";
            await RefreshAfterFailure();
        }
        catch (GameApiException error)
        {
            _error = error.Message;
            await RefreshAfterFailure();
        }
        catch (Exception)
        {
            _error = "The order could not be delivered. Check your connection and try again.";
            await RefreshAfterFailure();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task RemoveSeat(string seatId) => RunCommand(async () =>
    {
        ApplyProjection(await Sessions.RemoveSeatAsync(seatId, _pollCancellation.Token));
        _status = "The commander was removed from the war room.";
    }, "That commander could not be removed. The room has been refreshed; try again.", refreshAfterFailure: true);

    /// <summary>Gives up the lobby seat on the server, so the other commanders see it open again.</summary>
    private async Task LeaveWarRoom()
    {
        _generation++;
        bool confirmed;
        _isBusy = true;
        try
        {
            confirmed = await Sessions.LeaveSeatAsync(_pollCancellation.Token);
        }
        finally
        {
            _isBusy = false;
        }
        await ReturnToWarRoom();
        if (!confirmed)
        {
            _error = "The server could not be reached, so your seat may still show to the other commanders for a while.";
        }
    }

    private async Task WatchInstead()
    {
        if (_game is null)
        {
            return;
        }
        var gameId = _game.GameId;
        _generation++;
        _isBusy = true;
        try
        {
            await Sessions.LeaveSeatAsync(_pollCancellation.Token);
            ApplyProjection(await Sessions.WatchAsync(gameId, _pollCancellation.Token));
            _status = null;
            _error = null;
            StartPolling();
        }
        catch (OperationCanceledException) when (_pollCancellation.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            await ReturnToWarRoom();
            _error = "You left your seat, but the match could not be opened for watching. Try watching it by its code.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReturnToWarRoom()
    {
        _placingMonsters = false;
        var wasWatching = IsWatching;
        _generation++;
        await Sessions.LeaveAsync();
        _generation++;
        _game = null;
        _events.Clear();
        _lastSequence = 0;
        _liveAfterSequence = null;
        _error = null;
        _status = null;
        _watchOffer = null;
        if (wasWatching)
        {
            await OnStoppedWatching.InvokeAsync();
            await RestoreSavedSeat();
        }
    }

    private void ApplyEvents(EventPage? page)
    {
        if (page is null)
        {
            return;
        }
        _events.AddRange(page.Events.Where(gameEvent => gameEvent.Sequence > _lastSequence));
        if (_events.Count > 200)
        {
            _events.RemoveRange(0, _events.Count - 200);
        }
        _lastSequence = Math.Max(_lastSequence, page.LastSequence);
        _liveAfterSequence ??= _lastSequence;
    }

    private async Task CopyInvite()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteUrl);
            _status = "Invite link copied.";
            _error = null;
        }
        catch (JSException)
        {
            _error = "The invite could not be copied automatically. Select the link and copy it manually.";
        }
    }

    private async Task RunCommand(Func<Task> command, string errorMessage, bool refreshAfterFailure = false)
    {
        _isBusy = true;
        _error = null;
        try
        {
            await command();
        }
        catch (OperationCanceledException) when (_pollCancellation.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            _error = errorMessage;
            if (refreshAfterFailure)
            {
                await RefreshAfterFailure();
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RefreshAfterFailure()
    {
        try
        {
            var refreshed = await Sessions.ReconnectAsync(_pollCancellation.Token);
            if (refreshed is not null)
            {
                ApplyProjection(refreshed);
            }
        }
        catch (Exception) when (!_pollCancellation.IsCancellationRequested)
        {
        }
    }

    private void StartPolling()
    {
        if (_game is not null && (_pollTask is null || _pollTask.IsCompleted))
        {
            _pollTask = PollAsync(_pollCancellation.Token);
        }
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        var failures = 0;
        while (!cancellationToken.IsCancellationRequested)
        {
            var current = _game;
            if (current is null)
            {
                return;
            }
            var generation = _generation;

            var interval = PollingCadence.Select(
                PollingCadence.IsViewersMoment(current.Viewer, current.Turn.ActiveSeatId, null),
                current.PendingChoiceSummary is not null
                    || PollingCadence.IsViewersMoment(current.Viewer, null, current.Draft?.PickingSeatId),
                backgrounded: false,
                failures);

            try
            {
                await Task.Delay(interval, cancellationToken);
                if (_isBusy)
                {
                    continue;
                }

                var refreshed = await Sessions.ReconnectAsync(cancellationToken);
                EventPage? page = null;
                if (refreshed is not null && refreshed.Lifecycle != GameLifecycle.Lobby)
                {
                    try
                    {
                        page = await Sessions.GetEventsAsync(Reveals(refreshed) ? 0 : _lastSequence, cancellationToken);
                    }
                    catch (Exception) when (!cancellationToken.IsCancellationRequested)
                    {
                        // The projection still applies; the log catches up on the next poll.
                    }
                }
                if (refreshed is not null)
                {
                    await InvokeAsync(() =>
                    {
                        if (generation != _generation || (_game is not null && refreshed.GameId != _game.GameId))
                        {
                            return;
                        }
                        ApplyProjection(refreshed);
                        ApplyEvents(page);
                        failures = 0;
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch (GameApiException error) when (error.Code == "membershipRequired" && current.Viewer.Role != "spectator")
            {
                var removed = false;
                await InvokeAsync(async () =>
                {
                    if (generation != _generation)
                    {
                        return;
                    }
                    removed = true;
                    await ReturnToWarRoom();
                    _error = current.Lifecycle == GameLifecycle.Lobby
                        ? "The host removed you from the war room."
                        : "You no longer hold a seat in that match.";
                    StateHasChanged();
                });
                if (removed)
                {
                    return;
                }
            }
            catch (Exception)
            {
                failures++;
                await InvokeAsync(() =>
                {
                    _error = "Connection lost. Reconnecting automatically…";
                    StateHasChanged();
                });
            }
        }
    }

    private bool _placingMonsters;

    /// <summary>The Void Lord prepares on the board, not at the draft table, while the heroes draft.</summary>
    private bool VoidLordPreparing => _game is { Mode: GameMode.Coop, Setup.Redacted: false } && SeatNames.IsVoidLord(_game, _game.Viewer.SeatId);

    /// <summary>Each side's preparations were hidden from the other; the battle brings the whole history.</summary>
    private bool Reveals(GameProjection next) =>
        _game is { Mode: GameMode.Coop, Lifecycle: GameLifecycle.Draft } && next.Lifecycle == GameLifecycle.Active;

    private void ApplyProjection(GameProjection projection)
    {
        if (_game is null || _game.GameId != projection.GameId)
            _playEntrance = false;
        else if (projection.Version >= _game.Version && projection.Lifecycle == GameLifecycle.Active
            && _game.Lifecycle is GameLifecycle.Lobby or GameLifecycle.Draft or GameLifecycle.Setup)
            _playEntrance = true;
        if (_game is not null && _game.GameId != projection.GameId)
        {
            _events.Clear();
            _lastSequence = 0;
            _liveAfterSequence = null;
            _placingMonsters = false;
            _game = projection;
        }
        else if (_game is null || projection.Version >= _game.Version)
        {
            if (Reveals(projection))
            {
                _events.Clear();
                _lastSequence = 0;
                _liveAfterSequence = null;
            }
            _game = projection;
        }
    }

    private string DeviceId() => $"{ClientKind}-{Guid.NewGuid():N}";

    public async ValueTask DisposeAsync()
    {
        await _pollCancellation.CancelAsync();
        if (_pollTask is not null)
        {
            try
            {
                await _pollTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _pollCancellation.Dispose();
    }
}
