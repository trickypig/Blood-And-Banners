@namespace BloodAndBanners.UI.Components
@using BloodAndBanners.Contracts
@using BloodAndBanners.UI.Services

<main class="war-room">
    <header class="war-room__banner">
        <div>
            <p>Blood &amp; Banners</p>
            <h1>War room</h1>
        </div>
        <div class="war-room__scenario">
            <span>@ModeLabel(Projection.Mode)</span>
            <strong>@Projection.ScenarioName</strong>
        </div>
    </header>

    <section class="war-room__briefing" aria-labelledby="invite-heading">
        <div>
            <h2 id="invite-heading">@(IsCoop ? "Gather your allies" : "Call your rival")</h2>
            <p>@(IsCoop ? "Send this link to up to four allies and the commander who will play the Void Lord. This room admits five players." : "Send this link to the second commander. This room admits two players.")</p>
        </div>
        <div class="invite-card">
            <span>Game code</span>
            <strong data-testid="game-code">@Projection.GameId</strong>
            <label for="invite-link">Invite link</label>
            <input id="invite-link" data-testid="invite-link" readonly value="@InviteUrl" />
            <button type="button" data-action="copy-invite" @onclick="OnCopyInvite" disabled="@IsBusy">
                Copy invite link
            </button>
            @if (!string.IsNullOrEmpty(InviteUrl))
            {
                var qr = InviteQrCode.Create(InviteUrl);
                <figure class="invite-qr" data-testid="invite-qr">
                    <svg viewBox="0 0 @qr.Size @qr.Size" role="img" aria-label="QR code for the invite link" shape-rendering="crispEdges">
                        <rect width="@qr.Size" height="@qr.Size" fill="#fff" />
                        <path d="@qr.PathData" fill="#000" />
                    </svg>
                    <figcaption>Scan to join on a phone</figcaption>
                </figure>
            }
        </div>
    </section>

    <section class="war-room__muster" aria-labelledby="muster-heading">
        <div class="muster-heading">
            <div>
                <h2 id="muster-heading">Commanders</h2>
                <p>@ReadySummary</p>
            </div>
            <span class="muster-count">@Projection.Memberships.Count / @SeatLimit</span>
        </div>

        <CommanderNameField Projection="Projection" IsBusy="IsBusy" OnCommand="OnCommand" />

        <ol class="seat-list">
            @for (var seatIndex = 1; seatIndex <= SeatLimit; seatIndex++)
            {
                var seat = Projection.Memberships.FirstOrDefault(item => item.SeatIndex == seatIndex);
                <li data-seat="@seatIndex" class="@(seat is null ? "seat seat--open" : "seat")">
                    <span class="seat__sigil" aria-hidden="true">@seatIndex</span>
                    @if (seat is null)
                    {
                        <div><strong>Open banner</strong><span>Waiting for a commander</span></div>
                    }
                    else
                    {
                        <div>
                            <strong>@(string.IsNullOrEmpty(seat.Name) ? $"Commander {seat.SeatIndex}" : seat.Name) @ViewerLabel(seat)</strong>
                            <AddFriendButton GameId="@Projection.GameId" Seat="seat" ViewerSeatId="@Projection.Viewer.SeatId" />
                            <span>@(seat.IsHost ? "Host" : "Player")</span>
                            @if (SeatNames.IsVoidLord(Projection, seat.SeatId))
                            {
                                <span class="seat__role">Void Lord</span>
                            }
                            else if (IsCoop && Can("assignVoidLord"))
                            {
                                <button type="button" class="seat__assign" data-assign-seat="@seat.SeatId" disabled="@IsBusy"
                                        @onclick='() => Send("assignVoidLord", new { seatId = seat.SeatId })'>Make Void Lord</button>
                            }
                        </div>
                        <div class="seat__side">
                            <span class="seat__state @(seat.Ready ? "seat__state--ready" : null)">
                                @(seat.Ready ? "Ready" : "Not ready")
                            </span>
                            @if (Projection.Viewer.IsHost && seat.SeatId != Projection.Viewer.SeatId)
                            {
                                @if (_confirmRemoveSeatId == seat.SeatId)
                                {
                                    <button type="button" class="seat__remove seat__remove--confirm" data-confirm-remove="@seat.SeatId" disabled="@IsBusy"
                                            @onclick="() => RemoveSeat(seat.SeatId)">Confirm remove</button>
                                    <button type="button" class="seat__remove" data-keep-seat="@seat.SeatId"
                                            @onclick="() => _confirmRemoveSeatId = null">Keep</button>
                                }
                                else
                                {
                                    <button type="button" class="seat__remove" data-remove-seat="@seat.SeatId" disabled="@IsBusy"
                                            @onclick="() => _confirmRemoveSeatId = seat.SeatId">Remove</button>
                                }
                            }
                        </div>
                    }
                </li>
            }
        </ol>
    </section>

    <footer class="war-room__orders">
        @if (Can("claimVoidLord"))
        {
            <button type="button" class="role-order" data-action="claimVoidLord" disabled="@IsBusy" @onclick='() => Send("claimVoidLord", new { })'>Claim the Void Lord</button>
        }
        @if (Can("releaseVoidLord"))
        {
            <button type="button" class="role-order" data-action="releaseVoidLord" disabled="@IsBusy" @onclick='() => Send("releaseVoidLord", new { })'>Release the Void Lord</button>
        }
        <button type="button"
                class="ready-order"
                data-action="toggle-ready"
                disabled="@IsBusy"
                @onclick="ToggleReady">
            @(ViewerReady ? "Stand down" : "Ready your banner")
        </button>

        @if (IsCoop && SeatNames.IsVoidLord(Projection, Projection.Viewer.SeatId))
        {
            @if (Projection.Setup is not null)
            {
                <button type="button" class="ready-order" data-action="place-monsters" disabled="@IsBusy" @onclick="() => OnPlaceMonsters.InvokeAsync()">Place monsters</button>
            }
        }
        else if (IsCoop && VoidLordCount == 1)
        {
            <p class="host-note" data-testid="void-preparing">The Void Lord is preparing the horde.</p>
        }

        @if (Projection.Viewer.IsHost)
        {
            <button type="button"
                    class="start-order"
                    data-action="start-game"
                    disabled="@(!CanStart || IsBusy)"
                    @onclick="OnStart">
                @(IsCoop ? "Begin the incursion" : "Begin the draft")
            </button>
        }
        else
        {
            <p class="host-note">@(IsCoop ? "Waiting for the host to begin the incursion." : "Waiting for the host to begin the draft.")</p>
        }

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <p class="war-room__status" role="status">@StatusMessage</p>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <p class="war-room__error" role="alert">@ErrorMessage</p>
        }
    </footer>

    <div class="war-room__exit">
        <LeaveMatchControl Label="Cancel" ConfirmLabel="Confirm cancel" OnLeave="OnLeave" />
        <button type="button" class="watch-instead" data-action="watch-instead" disabled="@IsBusy" @onclick="OnWatchInstead">
            Watch instead
        </button>
    </div>
</main>

@code {
    [Parameter, EditorRequired]
    public GameProjection Projection { get; set; } = default!;

    [Parameter]
    public string InviteUrl { get; set; } = string.Empty;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? StatusMessage { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<bool> OnReadyChanged { get; set; }

    [Parameter]
    public EventCallback OnStart { get; set; }

    [Parameter]
    public EventCallback OnCopyInvite { get; set; }

    [Parameter]
    public EventCallback<GameCommandRequest> OnCommand { get; set; }

    [Parameter]
    public EventCallback OnLeave { get; set; }

    /// <summary>Gives up this seat and watches the same match as a spectator.</summary>
    [Parameter]
    public EventCallback OnWatchInstead { get; set; }

    /// <summary>The host removes another commander's seat.</summary>
    [Parameter]
    public EventCallback<string> OnRemoveSeat { get; set; }

    private string? _confirmRemoveSeatId;

    private async Task RemoveSeat(string seatId)
    {
        _confirmRemoveSeatId = null;
        await OnRemoveSeat.InvokeAsync(seatId);
    }

    private int SeatLimit => Projection.SeatLimit ?? (Projection.Mode == GameMode.VanillaPvp ? 2 : 5);

    private MembershipProjection? ViewerMembership =>
        Projection.Memberships.FirstOrDefault(seat => seat.SeatId == Projection.Viewer.SeatId);

    private bool ViewerReady => ViewerMembership?.Ready ?? false;

    [Parameter] public EventCallback OnPlaceMonsters { get; set; }

    private bool IsCoop => Projection.Mode == GameMode.Coop;

    private int VoidLordCount => LobbyRules.VoidLordCount(Projection);

    private bool CanStart => LobbyRules.CanStart(Projection);

    private string ReadySummary
    {
        get
        {
            var ready = $"{Projection.Memberships.Count(seat => seat.Ready)} of {Projection.Memberships.Count} commanders ready";
            if (!IsCoop)
            {
                return ready;
            }
            if (VoidLordCount == 0)
            {
                return $"{ready} · Needs a Void Lord";
            }
            return Projection.Memberships.Count - VoidLordCount < 1 ? $"{ready} · Needs a hero player" : ready;
        }
    }

    private bool Can(string kind) => Projection.LegalActions.Any(action => action.Kind == kind);

    private Task Send(string kind, object payload) => OnCommand.InvokeAsync(new GameCommandRequest(kind, payload));

    private Task ToggleReady() => OnReadyChanged.InvokeAsync(!ViewerReady);

    private string ViewerLabel(MembershipProjection seat) =>
        seat.SeatId == Projection.Viewer.SeatId ? "(You)" : string.Empty;

    private static string ModeLabel(GameMode mode) => GameModeLabels.For(mode);
}
